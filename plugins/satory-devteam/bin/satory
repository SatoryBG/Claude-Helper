#!/usr/bin/env python3
"""satory - mechanical helper for the satory agent team.

Every subcommand prints exactly one JSON object on stdout. The satory-build
workflow calls it for everything that has to be deterministic rather than an
agent's opinion: plan state, guards on who may touch which files, build/test
gates, checkpoints, the append-only journal, merge/push and local deploys.
"""
from __future__ import annotations

import argparse
import datetime as dt
import functools
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path, PurePosixPath

TRAILER = "Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>"
CMD_TIMEOUT = 45 * 60
HEALTH_TIMEOUT = 120
PROTECTED = [".satory/**", "docs/JOURNAL.md"]
DOCS_ALLOWED = ["docs/**", "**/*.md"]
STATUSES = ("todo", "in_progress", "blocked", "done")
OWNERS = ("dev", "devops")
MIN_PYTHON = (3, 10)
VERDICT_MARK = {"pass": "✓", "approve": "✓", "ok": "✓", "done": "✓",
                "fail": "✗", "changes_requested": "✗", "gate-fail": "✗",
                "blocked": "⛔", "unblocked": "↻", "release": "🚀"}
SATORY_HOME = Path(__file__).resolve().parent.parent


class SatoryError(Exception):
    pass


def emit(obj: dict) -> None:
    print(json.dumps(obj, ensure_ascii=False, separators=(",", ":")))


def now(fmt: str = "%Y-%m-%d %H:%M:%S") -> str:
    return dt.datetime.now().strftime(fmt)


def load_json(path: Path, default=None):
    if not path.exists():
        if default is None:
            raise SatoryError(f"missing {path}")
        return default
    return json.loads(path.read_text(encoding="utf-8"))


def write_json(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


@functools.lru_cache(maxsize=None)
def glob_regex(glob: str) -> re.Pattern:
    """Whole-path glob like PurePath.full_match (Python 3.13+), here so older Pythons behave the same:
    "**/" spans zero or more segments, a trailing "/**" one or more, "*" and "?" stay inside one segment."""
    out, i = [], 0
    while i < len(glob):
        if glob.startswith("**/", i):
            out.append("(?:[^/]+/)*")
            i += 3
        elif glob.startswith("/**", i) and i + 3 == len(glob):
            out.append("(?:/[^/]+)+")
            i += 3
        elif glob.startswith("**", i):
            out.append(".*")
            i += 2
        else:
            out.append({"*": "[^/]*", "?": "[^/]"}.get(glob[i], re.escape(glob[i])))
            i += 1
    return re.compile("".join(out) + r"\Z")


def matches(path: str, globs: list[str]) -> bool:
    p = str(PurePosixPath(path))
    return any(glob_regex(g).match(p) for g in globs)


def as_list(value) -> list[str]:
    if not value:
        return []
    return [value] if isinstance(value, str) else list(value)


# ---------------------------------------------------------------- project ---

class Project:
    def __init__(self, root: Path):
        self.root = root
        self.dir = root / ".satory"
        self.run = self.dir / "run"
        self.logs = self.run / "logs"
        self.config = load_json(self.dir / "project.json")
        self.state_path = self.run / "state.json"
        self.state = load_json(self.state_path, {"tasks": {}, "deploy": {}})
        self.pending = self.run / "journal.pending.md"
        self.questions_path = self.dir / "questions.json"
        self.questions_pending = self.run / "questions.pending.json"
        self.progress_path = self.run / "progress.log"

    @classmethod
    def find(cls, start: str | None) -> "Project":
        here = Path(start or os.getcwd()).resolve()
        for d in (here, *here.parents):
            if (d / ".satory" / "project.json").exists():
                return cls(d)
        raise SatoryError(f"no .satory/project.json in {here} or its parents")

    # state / plan
    def save_state(self) -> None:
        write_json(self.state_path, self.state)

    def plan(self) -> dict:
        return load_json(self.dir / "plan.json", {"milestones": [], "tasks": []})

    def save_plan(self, plan: dict) -> None:
        write_json(self.dir / "plan.json", plan)

    def task(self, plan: dict, tid: str) -> dict:
        for t in plan["tasks"]:
            if t["id"] == tid:
                return t
        raise SatoryError(f"unknown task {tid}")

    def task_state(self, tid: str) -> dict:
        st = self.state["tasks"].get(tid)
        if not st:
            raise SatoryError(f"task {tid} is not started (run: task start {tid})")
        return st

    # config
    @property
    def main(self) -> str:
        return self.config.get("main_branch", "main")

    @property
    def test_globs(self) -> list[str]:
        return self.config.get("paths", {}).get("tests", [])

    def commands(self, name: str) -> list[str]:
        return as_list(self.config.get("commands", {}).get(name))

    def experimental(self, name: str) -> list[str]:
        """Opt-in trial settings under "experimental" in project.json; removing the block turns them off."""
        return as_list(self.config.get("experimental", {}).get(name))

    def e2e_task_commands(self, tid: str) -> list[str]:
        """The e2e commands for one task's own tests plus the smoke tests ({task} becomes the task id):
        commands.e2e_task or - for Playwright - the e2e commands with --grep "{task}|@smoke" appended.
        Empty when none can be derived: then the whole suite runs."""
        cmds = self.commands("e2e_task")
        if not cmds:
            e2e = self.commands("e2e")
            if e2e and all(re.search(r"playwright test(?!.*(\||--grep|\s-g\s))[^|]*$", c) for c in e2e):
                cmds = [c + ' --grep "{task}|@smoke"' for c in e2e]
        return [c.replace("{task}", tid) for c in cmds]

    def env(self, tid: str = "", rnd: int = 0) -> dict:
        env = dict(os.environ)
        env.update({"SATORY_PROJECT_ROOT": str(self.root), "SATORY_TASK": tid,
                    "SATORY_ROUND": str(rnd)})
        staging = self.config.get("deploy", {}).get("environments", {}).get("staging")
        if staging:
            env["SATORY_BASE_URL"] = staging["url"]
        return env

    # git
    def git(self, *args: str, check: bool = True) -> str:
        r = subprocess.run(["git", *args], cwd=self.root, capture_output=True, text=True)
        if check and r.returncode != 0:
            raise SatoryError(f"git {' '.join(args)}: {(r.stderr or r.stdout).strip()}")
        return r.stdout.strip() if check else r

    def git_ok(self, *args: str) -> bool:
        return subprocess.run(["git", *args], cwd=self.root, capture_output=True).returncode == 0

    def branch_exists(self, branch: str) -> bool:
        return self.git_ok("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}")

    def current_branch(self) -> str:
        return self.git("rev-parse", "--abbrev-ref", "HEAD")

    def dirty(self) -> bool:
        return bool(self.git("status", "--porcelain"))

    def rel(self, path: Path) -> str:
        return str(path.relative_to(self.root))


def changed_files(p: Project, ref: str) -> dict[str, str]:
    """Paths that differ between `ref` and the working tree → M/A/D."""
    files: dict[str, str] = {}
    for line in p.git("diff", "--name-status", "--no-renames", ref).splitlines():
        if line:
            status, path = line.split("\t", 1)
            files[path] = status[0]
    for path in p.git("ls-files", "--others", "--exclude-standard").splitlines():
        if path:
            files[path] = "A"
    return files


def restore(p: Project, ref: str, path: str, status: str) -> None:
    if status == "A" and not p.git_ok("cat-file", "-e", f"{ref}:{path}"):
        f = p.root / path
        if f.is_dir():
            shutil.rmtree(f)
        elif f.exists() or f.is_symlink():
            f.unlink()
        p.git("rm", "-q", "--cached", "--ignore-unmatch", "--", path)
    else:
        p.git("checkout", ref, "--", path)


def checkpoint(p: Project, tid: str, label: str) -> str:
    p.git("add", "-A")
    p.git("commit", "-q", "--allow-empty", "--no-verify", "-m", f"wip({tid}): {label}")
    if p.config.get("push_task_branch", True) is not False:
        # a copy of the work in progress on GitHub; forced, since resuming rebases the branch
        push_quiet(p, "--force", "origin", f"HEAD:refs/heads/{p.current_branch()}")
    return p.git("rev-parse", "HEAD")


def push_quiet(p: Project, *args: str) -> str | None:
    """git push to origin, if there is one; it never fails the step. Returns the error, if any."""
    if not p.git_ok("remote", "get-url", "origin"):
        return None
    try:
        r = subprocess.run(["git", "push", "-q", *args], cwd=p.root, capture_output=True, text=True,
                           timeout=120, env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
    except subprocess.TimeoutExpired:
        return "git push timed out"
    return None if r.returncode == 0 else (r.stderr or r.stdout).strip()[-500:]


# ------------------------------------------------------- commands & gates ---

def run_cmds(p: Project, cmds: list[str], log: Path, env: dict) -> dict:
    if not cmds:
        return {"ok": True, "skipped": True}
    log.parent.mkdir(parents=True, exist_ok=True)
    code = 0
    with open(log, "w", encoding="utf-8") as f:
        for cmd in cmds:
            f.write(f"$ {cmd}\n")
            f.flush()
            try:
                code = subprocess.run(cmd, shell=True, executable="/bin/bash", cwd=p.root,
                                      stdout=f, stderr=subprocess.STDOUT, env=env,
                                      timeout=CMD_TIMEOUT).returncode
            except subprocess.TimeoutExpired:
                f.write(f"\n[satory] timeout after {CMD_TIMEOUT}s\n")
                code = 124
            f.write(f"\n[satory] exit {code}\n")
            if code != 0:
                break
    return {"ok": code == 0, "exit": code, "log": p.rel(log)}


# a crash of the runtime or the test host, not a failing test: the gate runs once more before it fails
CRASH = re.compile(r"Internal CLR error|^Fatal error\.|Segmentation fault|core dumped|Test host process crashed"
                   r"|The active test run was aborted|FATAL ERROR: .*JavaScript heap"
                   r"|Restore operation failed|Unable to load the service index|error NU1301|ECONNRESET|ETIMEDOUT",
                   re.M)


UNIT_FAILED = re.compile(r"^\s*(?:failed|FAIL|×|✗)\s+(.+?)(?:\s+\(\d[\d.]*\s*m?s\))?\s*$", re.M)


def unit_retry(p: Project, tid: str, rnd: int, res: dict, text: str) -> dict:
    """A few failing unit tests are run once more (the whole command, it is quick): passing then counts as
    passing, and the tests go to the register as flaky, as for e2e. Many failures are a real failure."""
    names = sorted({m.strip() for m in UNIT_FAILED.findall(text)})[:20]
    if not names or len(names) > int(p.config.get("unit_retry_max", 3)):
        return res
    progress(p, f"↻ {tid} r{rnd} test: {len(names)} unit test(s) failed, running the tests once more")
    again = run_cmds(p, p.commands("test"), p.logs / f"{tid}-r{rnd}-test-retry.log", p.env(tid, rnd))
    if not again["ok"]:
        return res
    for test in names:
        question_flaky(p, f"unit › {test}", f"test {tid} r{rnd}", tid)
    return {**again, "flaky": names, "retry_log": again["log"], "log": res["log"]}


def gate(p: Project, tid: str, rnd: int, name: str) -> dict:
    log = p.logs / f"{tid}-r{rnd}-{name}.log"
    res = run_cmds(p, p.commands(name), log, p.env(tid, rnd))
    if res["ok"] or res.get("skipped"):
        return res
    text = log.read_text(encoding="utf-8", errors="replace") if log.exists() else ""
    if not ((isinstance(res.get("exit"), int) and res["exit"] < 0) or CRASH.search(text)):
        if name == "test":
            return unit_retry(p, tid, rnd, res, text)
        return res
    progress(p, f"↻ {tid} r{rnd} {name}: the run crashed (exit {res.get('exit')}), running it once more")
    again = run_cmds(p, p.commands(name), p.logs / f"{tid}-r{rnd}-{name}-rerun.log", p.env(tid, rnd))
    again["crashed_first"] = res["log"]
    return again


E2E_COUNT = re.compile(r"^\s*(\d+) (passed|failed|flaky|skipped|did not run|interrupted)\b", re.M)
E2E_FAILED = re.compile(r"^\s*\d+ failed\s*$(.*?)(?=^\s*\d+ (?:passed|flaky|skipped|did not run|interrupted)\b|^\[satory\]|\Z)",
                        re.M | re.S)


def e2e_failures(log: Path) -> tuple[int, int, list[str]]:
    """(failed, total, failed test names) from the summary of a Playwright run (line/list reporter)."""
    text = log.read_text(encoding="utf-8", errors="replace") if log.exists() else ""
    counts: dict[str, int] = {}
    for n, kind in E2E_COUNT.findall(text):
        counts[kind] = int(n)
    m = E2E_FAILED.search(text)
    names = [x.strip() for x in m.group(1).splitlines() if x.strip().startswith("[")] if m else []
    return counts.get("failed", 0), sum(counts.values()), names


def e2e_run(p: Project, tid: str, rnd: int, cmds: list[str], name: str) -> dict:
    """Run e2e commands; when a few tests fail (at most e2e_retry_max_percent of the run), run only those
    once more with commands.e2e_retry. Passing then counts as passing; the tests go to the register as flaky."""
    log = p.logs / f"{tid}-r{rnd}-{name}.log"
    res = run_cmds(p, cmds, log, p.env(tid, rnd))
    retry = p.commands("e2e_retry")
    if res["ok"] or res.get("skipped") or not retry:
        return res
    failed, total, names = e2e_failures(log)
    limit = max(1, int(total * float(p.config.get("e2e_retry_max_percent", 3)) / 100))
    if not failed or not total or failed > limit or len(names) != failed:
        res["retry"] = f"not retried: {failed} of {total} failed (retry limit {limit})"
        return res
    rlog = p.logs / f"{tid}-r{rnd}-{name}-retry.log"
    again = run_cmds(p, retry, rlog, p.env(tid, rnd))
    res["retry_log"] = again["log"]
    if again["ok"]:
        res.update(ok=True, exit=0, flaky=names)
        for test in names:
            question_flaky(p, test, f"{name} {tid} r{rnd}", tid)
    return res


def test_names(p: Project, tid: str = "", rnd: int = 0, cache: bool = False) -> tuple[bool, set[str]]:
    cmds = p.commands("test_list")
    if not cmds:
        return False, set()
    names: set[str] = set()
    for cmd in cmds:
        r = subprocess.run(cmd, shell=True, executable="/bin/bash", cwd=p.root, capture_output=True,
                           text=True, env=p.env(tid, rnd), timeout=CMD_TIMEOUT)
        if r.returncode != 0:
            return False, set()
        names.update(line.strip() for line in r.stdout.splitlines() if line.strip())
    if cache:  # the latest list of main's tests, for the coverage register (listing them can take minutes)
        try:
            write_json(p.run / "tests.json", {"listed": now(), "names": sorted(names)})
        except OSError:
            pass
    return True, names


# -------------------------------------------------------------- questions ---
# Questions for the user never stop the workflow: Dev's assumptions, the SPEC gaps the Reviewer and QA
# notice and the milestone reviews collect here, and the user answers them with /satory-devteam:status
# whenever it suits them. While a task runs, the register lives in a gitignored working copy; it is
# written to .satory/questions.json and docs/QUESTIONS.md on main together with the journal.

Q_KINDS = ("question", "decision", "fix", "test", "request")
Q_SEVERITIES = ("critical", "major", "minor")
Q_STATUSES = ("open", "deferred", "answered", "dismissed", "planned", "resolved")  # deferred: "Later", not counted
Q_BRIEF = ("id", "kind", "severity", "status", "title", "task", "from_task")


def questions_load(p: Project) -> dict:
    path = p.questions_pending if p.questions_pending.exists() else p.questions_path
    reg = load_json(path, {"items": [], "milestones_reviewed": []})
    reg.setdefault("items", [])
    reg.setdefault("milestones_reviewed", [])
    reg.setdefault("ux_reviewed", [])
    return reg


def questions_save(p: Project, reg: dict) -> None:
    write_json(p.questions_pending, reg)
    register_file(p, reg)


def register_file(p: Project, reg: dict) -> Path:
    """A compact copy of the register (id, status, title) that the agents read with their tools, so the
    workflow never has to pass a long list through an agent's output."""
    path = p.run / "register.md"
    lines = ["# Register of questions (generated - id [status] title)", ""]
    lines += [f"- {q['id']} [{q['status']}] {q['title']}" for q in reg["items"] if q["status"] != "dismissed"]
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return path


def question_key(title: str) -> str:
    return " ".join(re.sub(r"[^\w\s]", " ", title.casefold()).split())


def questions_render(reg: dict) -> str:
    lines = ["# Questions for the user", "",
             "Generated by satory from `.satory/questions.json` - answer them with `/satory-devteam:status`.", ""]
    for status, heading in (("open", "Open"), ("deferred", "Later"), ("answered", "Answered"), ("planned", "Planned"),
                            ("resolved", "Resolved without a task"), ("dismissed", "Dismissed")):
        items = [q for q in reg["items"] if q["status"] == status]
        if not items:
            continue
        lines += [f"## {heading} ({len(items)})", ""]
        for q in sorted(items, key=lambda q: (Q_SEVERITIES.index(q["severity"]), q["id"])):
            lines.append(f"### {q['id']} · {q['kind']} · {q['severity']} - {q['title']}")
            lines.append("")
            lines.append(f"Source: {q['source']} ({q['created']})" + (f" · refs: {', '.join(q['refs'])}" if q.get("refs") else ""))
            lines += ["", q["detail"].strip(), ""]
            if q.get("options"):
                lines += [f"- {o}" for o in q["options"]] + [""]
            if q.get("answer"):
                lines += [f"**Answer ({q.get('answered', '')}):** {q['answer'].strip()}", ""]
            if q.get("task"):
                lines += [f"**Planned as:** {q['task']}", ""]
            if q.get("resolution"):
                lines += [f"**Resolution:** {q['resolution']}", ""]
    return "\n".join(lines).rstrip() + "\n"


def questions_flush(p: Project) -> None:
    """Write the working copy to .satory/questions.json and docs/QUESTIONS.md (call only on main)."""
    if not p.questions_pending.exists():
        return
    reg = questions_load(p)
    write_json(p.questions_path, reg)
    (p.root / "docs").mkdir(exist_ok=True)
    (p.root / "docs" / "QUESTIONS.md").write_text(questions_render(reg), encoding="utf-8")
    p.questions_pending.unlink()


def question_append(reg: dict, item: dict, source: str, task: str | None, milestone: str | None) -> dict:
    num = 1 + max((int(q["id"][2:]) for q in reg["items"]), default=0)
    q = {"id": f"Q-{num:03d}", "kind": item.get("kind") if item.get("kind") in Q_KINDS else "question",
         "severity": item.get("severity") if item.get("severity") in Q_SEVERITIES else "major",
         "title": str(item.get("title", "")).strip(), "detail": str(item.get("detail", "")).strip(),
         "options": [str(o) for o in item.get("options") or []], "refs": [str(r) for r in item.get("refs") or []],
         "source": source, "task": None, "milestone": milestone, "from_task": task, "created": now("%Y-%m-%d"),
         "status": "open", "answer": None, "answered": None}
    for k in ("key", "occurrences"):
        if k in item:
            q[k] = item[k]
    reg["items"].append(q)
    return q


FLAKY_ESCALATE = 3  # a test flaky this many times is likely a real timing problem: major, reopened


def question_flaky(p: Project, test: str, source: str, task: str) -> None:
    """Record a test that failed and passed on the retry; repeated flakiness raises the severity."""
    name = re.sub(r":\d+:\d+", "", test).strip()
    reg = questions_load(p)
    key = f"flaky:{name}"
    q = next((x for x in reg["items"] if x.get("key") == key), None)
    if q is None:
        question_append(reg, {
            "kind": "test", "severity": "minor", "key": key, "occurrences": [source],
            "title": f"Flaky e2e test: {name}",
            "detail": "The test failed and passed when it was run again, so the task went on. A test that fails "
                      "now and then either waits for time instead of a state, or hides a real timing problem in "
                      "the app; it is escalated when it keeps happening.",
            "options": ["Plan it: make the test wait for the state it checks (QA), or fix the race in the app",
                        "Not needed"],
            "refs": [test.split(" › ")[1] if " › " in test else test]}, source, task, None)
        progress(p, f"❓ {reg['items'][-1]['id']}: flaky e2e test ({source}) - {name.split(' › ')[-1]}")
    else:
        q.setdefault("occurrences", []).append(source)
        if q["status"] == "deferred":  # it happened again: back to the user
            q["status"] = "open"
            progress(p, f"❓ {q['id']} is open again: the test was flaky once more ({source})")
        if len(q["occurrences"]) >= FLAKY_ESCALATE and q["severity"] == "minor":
            q["severity"] = "major"
            q["detail"] += f" Flaky {len(q['occurrences'])} times so far: likely a real timing problem."
            if q["status"] in ("dismissed", "resolved"):
                q["status"] = "open"
    questions_save(p, reg)


def question_find(reg: dict, qid: str) -> dict:
    for q in reg["items"]:
        if q["id"] == qid:
            return q
    raise SatoryError(f"unknown question {qid}")


def cmd_question(p: Project, a) -> None:
    reg = questions_load(p)
    if a.action == "add":
        try:
            new = json.loads(sys.stdin.read() or "[]")
        except json.JSONDecodeError as e:
            raise SatoryError(f"question add expects a JSON list on stdin: {e}")
        if isinstance(new, dict):
            new = new.get("items", [])
        seen = {question_key(q["title"]) for q in reg["items"]}
        deferred = {question_key(q["title"]): q for q in reg["items"] if q["status"] == "deferred"}
        added, skipped, reopened = [], [], []  # added: the new items as {id, title}
        for item in new:
            title = str(item.get("title", "")).strip()
            if not title:
                continue
            if question_key(title) in seen:
                skipped.append(title)
                q = deferred.pop(question_key(title), None)
                if q:  # an agent raised a postponed item again: it is open again
                    q["status"] = "open"
                    reopened.append(q["id"])
                continue
            seen.add(question_key(title))
            q = question_append(reg, item, a.source or "manual", a.task, a.milestone)
            added.append({"id": q["id"], "title": q["title"]})
        if added or reopened:
            questions_save(p, reg)
        if added:
            ids = [x["id"] for x in added]
            progress(p, f"❓ {len(added)} new question(s) from {a.source or 'manual'}: "
                        f"{', '.join(ids) if len(ids) <= 4 else f'{ids[0]}…{ids[-1]}'}")
        if reopened:
            progress(p, f"❓ open again, raised once more by {a.source or 'manual'}: {', '.join(reopened)}")
        return emit({"ok": True, "added": [x["id"] for x in added], "added_items": added, "skipped": skipped,
                     "reopened": reopened})
    if a.action == "list":
        # the output goes through an agent's tool output, so it stays small: open items in full,
        # answered ones with the answer and refs, closed ones (and with --brief all) only what
        # identifies them; --full shows everything
        wanted = ["open"] if a.open else [x for x in (a.status or "").split(",") if x]
        bad = [x for x in wanted if x not in Q_STATUSES]
        if bad:
            raise SatoryError(f"unknown status {', '.join(bad)} (known: {', '.join(Q_STATUSES)})")
        items = [q for q in reg["items"] if not wanted or q["status"] in wanted]
        if not a.full:
            items = [q if not a.brief and q["status"] == "open"
                     else {k: q.get(k) for k in Q_BRIEF + (("answer", "refs") if not a.brief
                                                           and q["status"] == "answered" else ())}
                     for q in items]
        open_items = [q for q in reg["items"] if q["status"] == "open"]
        return emit({"ok": True, "items": items, "open": len(open_items),
                     "critical_open": sum(q["severity"] == "critical" for q in open_items),
                     "deferred": sum(q["status"] == "deferred" for q in reg["items"]),
                     "milestones_reviewed": reg["milestones_reviewed"], "ux_reviewed": reg["ux_reviewed"]})
    if a.action == "answer":
        q = question_find(reg, a.target)
        if a.status and a.status not in ("answered", "deferred", "dismissed", "planned", "resolved"):
            raise SatoryError("question answer --status is answered, deferred, dismissed, planned or resolved")
        if a.status == "deferred" and q["severity"] == "critical":
            raise SatoryError(f"{q['id']} is critical: it stays open (it holds the next milestone) until answered")
        q["status"] = a.status or "answered"
        q["answer"] = read_note(a).strip() or q.get("answer")
        q["answered"] = now("%Y-%m-%d")
    elif a.action == "plan":
        if not a.task:
            raise SatoryError("question plan needs --task")
        q = question_find(reg, a.target)
        q["status"], q["task"] = "planned", a.task
    elif a.action == "reviewed":
        if a.target not in reg["milestones_reviewed"]:
            reg["milestones_reviewed"].append(a.target)
    elif a.action == "ux-reviewed":
        if a.target not in reg["ux_reviewed"]:
            reg["ux_reviewed"].append(a.target)
    elif a.action == "register":
        path = register_file(p, reg)
        return emit({"ok": True, "path": p.rel(path), "count": sum(q["status"] != "dismissed" for q in reg["items"])})
    elif a.action == "flush":
        if p.current_branch() != p.main:
            return emit({"ok": False, "error": f"not on {p.main}; the questions are written at the next task finish"})
        if not p.questions_pending.exists():
            return emit({"ok": True, "flushed": False})
        questions_flush(p)
        p.git("add", str(p.questions_path), "docs/QUESTIONS.md")
        p.git("commit", "-q", "-m", f"chore(satory): questions for the user\n\n{TRAILER}")
        return emit({"ok": True, "flushed": True})
    questions_save(p, reg)
    emit({"ok": True})


# ---------------------------------------------------------------- journal ---

def progress(p: Project, line: str) -> None:
    """One short line per event in .satory/run/progress.log (gitignored): what the build skill streams
    into the conversation and the status line shows. Never fails the command that reports it."""
    try:
        p.run.mkdir(parents=True, exist_ok=True)
        with open(p.progress_path, "a", encoding="utf-8") as f:
            f.write(f"{now('%H:%M')} {' '.join(line.split())[:220]}\n")
        if p.progress_path.stat().st_size > 256 * 1024:
            lines = p.progress_path.read_text(encoding="utf-8").splitlines(keepends=True)
            p.progress_path.write_text("".join(lines[-500:]), encoding="utf-8")
    except OSError:
        pass


def first_line(text: str, limit: int = 140) -> str:
    line = next((x.strip() for x in (text or "").splitlines() if x.strip()), "")
    return line if len(line) <= limit else line[:limit - 1] + "…"


def journal_pending(p: Project, tid: str, stage: str, rnd: int | None, verdict: str, note: str) -> None:
    """Entries go to a gitignored file while a task runs and are flushed into
    docs/JOURNAL.md on main, so they survive even when a task branch is abandoned."""
    mark = VERDICT_MARK.get(verdict, "•")
    where = f" · round {rnd}" if rnd else ""
    entry = f"\n### {now()} · {tid}{where} · {stage} · {mark} {verdict}\n\n{note.strip() or '-'}\n"
    p.pending.parent.mkdir(parents=True, exist_ok=True)
    with open(p.pending, "a", encoding="utf-8") as f:
        f.write(entry)
    if stage != "docs":  # the finish reports the task as a whole
        detail = first_line(note) if verdict in ("blocked", "unblocked", "release") or tid == "plan" else ""
        progress(p, f"{mark} {tid}{f' r{rnd}' if rnd else ''} {stage}: {verdict}{f' - {detail}' if detail else ''}")


def journal_flush(p: Project) -> None:
    """Append pending entries to docs/JOURNAL.md (call only on the main branch)."""
    questions_flush(p)
    if not p.pending.exists():
        return
    text = p.pending.read_text(encoding="utf-8")
    journal = p.root / "docs" / "JOURNAL.md"
    journal.parent.mkdir(parents=True, exist_ok=True)
    with open(journal, "a", encoding="utf-8") as f:
        f.write(text)
    p.pending.unlink()


def join_note(note: str, lines: list[str]) -> str:
    return "\n\n".join(part for part in (note.strip(), "\n".join(lines).strip()) if part)


def read_note(args) -> str:
    return sys.stdin.read() if getattr(args, "note_stdin", False) else ""


# ------------------------------------------------------------------- plan ---

def merged_status(p: Project, t: dict) -> str:
    status = t.get("status", "todo")
    if status == "todo" and t["id"] in p.state["tasks"]:
        return "in_progress"
    return status


def done_count(p: Project, plan: dict) -> str:
    return f"{sum(t.get('status') == 'done' for t in plan['tasks'])}/{len(plan['tasks'])} tasks done"


def validate_plan(plan: dict) -> list[str]:
    errors = []
    ids = [t.get("id") for t in plan.get("tasks", [])]
    if len(ids) != len(set(ids)):
        errors.append("duplicate task ids")
    known = set(ids)
    milestones = {m["id"] for m in plan.get("milestones", [])}
    for t in plan.get("tasks", []):
        tid = t.get("id", "?")
        for field in ("id", "title", "owner", "description", "acceptance"):
            if not t.get(field):
                errors.append(f"{tid}: missing {field}")
        if t.get("owner") not in OWNERS:
            errors.append(f"{tid}: owner must be one of {OWNERS}")
        if "ui" in t and not isinstance(t["ui"], bool):
            errors.append(f"{tid}: ui must be true or false")
        if t.get("status", "todo") not in STATUSES:
            errors.append(f"{tid}: bad status {t.get('status')}")
        if milestones and t.get("milestone") not in milestones:
            errors.append(f"{tid}: unknown milestone {t.get('milestone')}")
        for dep in t.get("depends_on", []):
            if dep not in known:
                errors.append(f"{tid}: unknown dependency {dep}")
    deps = {t["id"]: t.get("depends_on", []) for t in plan.get("tasks", []) if "id" in t}
    visiting, done = set(), set()

    def visit(n):
        if n in done:
            return
        if n in visiting:
            errors.append(f"dependency cycle through {n}")
            return
        visiting.add(n)
        for d in deps.get(n, []):
            if d in deps:
                visit(d)
        visiting.discard(n)
        done.add(n)

    for n in deps:
        visit(n)
    return errors


STATUS_LABEL = {"todo": "to do", "in_progress": "in progress", "blocked": "⛔ blocked", "done": "✓ done"}


def task_source(t: dict, by_id: dict) -> str:
    """Where a task comes from: the plan, or the questions it covers grouped by their origin; the questions
    that extended a task planned before follow after a +."""
    ext = t.get("extended") or []
    own = source_groups([x for x in t.get("questions") or [] if x not in ext], by_id) or "plan"
    return f"{own} + {source_groups(ext, by_id)}" if ext else own


def source_groups(qids: list, by_id: dict) -> str:
    groups: dict = {}
    for qid in qids:
        q = by_id.get(qid, {})
        src = str(q.get("source") or "")
        if q.get("kind") == "request":
            label = "request"
        elif str(q.get("key") or "").startswith("flaky:"):
            label = "flaky test"
        elif src.startswith("milestone "):
            label = src.removeprefix("milestone ")
        elif q.get("from_task"):
            label = q["from_task"]
        else:
            label = "question"
        groups.setdefault(label, []).append(qid)
    return "; ".join(f"{k} {', '.join(v)}" for k, v in groups.items())


def render_plan(p: Project, plan: dict) -> None:
    lines = [f"# Plan - {p.config.get('name', p.root.name)}", "",
             "> Generated from `.satory/plan.json` by `satory plan render` - do not edit by hand.", ""]
    milestones = plan.get("milestones") or [{"id": None, "title": "Tasks"}]
    by_id = {q["id"]: q for q in questions_load(p)["items"]}
    for m in milestones:
        tasks = [t for t in plan["tasks"] if m["id"] is None or t.get("milestone") == m["id"]]
        lines += [f"## {m['id'] + ' - ' if m['id'] else ''}{m['title']}", "",
                  "| ID | Task | Owner | Depends on | Source | Status |", "|---|---|---|---|---|---|"]
        for t in tasks:
            lines.append(f"| {t['id']} | {t['title']} | {t['owner']} | "
                         f"{', '.join(t.get('depends_on', [])) or '-'} | {task_source(t, by_id)} | "
                         f"{STATUS_LABEL[merged_status(p, t)]} |")
        lines.append("")
    lines += ["Source: `plan` - the architect's plan; `request` - a request from the user; `M2 review` - the "
              "milestone review; `T-0xx` - found by Dev, the Reviewer or QA in that task; `flaky test` - an e2e "
              "test that passed only on the retry. The question ids are in `docs/QUESTIONS.md`.", "",
              "## Details", ""]
    for t in plan["tasks"]:
        lines += [f"### {t['id']} - {t['title']}", "", t["description"], "",
                  f"Requirements: {', '.join(t.get('requirements', [])) or '-'}", "", "Acceptance criteria:"]
        lines += [f"- {ac}" for ac in t["acceptance"]]
        if t.get("blocked_reason"):
            lines += ["", f"**Blocked:** {t['blocked_reason']}"]
        lines.append("")
    (p.root / "docs").mkdir(exist_ok=True)
    (p.root / "docs" / "PLAN.md").write_text("\n".join(lines), encoding="utf-8")


CLAR_START, CLAR_END = "<!-- satory:clarifications -->", "<!-- /satory:clarifications -->"


def clarifications_block(t: dict) -> str:
    items = t.get("clarifications", [])
    body = "\n".join(f"- {c['date']}: {c['text']}" for c in items) or "_none_"
    return f"{CLAR_START}\n{body}\n{CLAR_END}"


ADAPTED_HEADING = re.compile(r"^##\s+QA: adapted tests\s*$", re.M)
ADAPTED_ENTRY = re.compile(r"^\s*[-*]\s+`([^`]+)`\s*[:\-–—]\s*(\S.*)$")


def adapted_tests(path: Path) -> dict[str, str]:
    """Test files from earlier tasks that QA declared as adapted, with the reason: the entries
    "- `path`: reason" of the "QA: adapted tests" section of the task file."""
    if not path.exists():
        return {}
    text = re.sub(r"<!--.*?-->", "", path.read_text(encoding="utf-8"), flags=re.S)
    entries = {}
    for m in ADAPTED_HEADING.finditer(text):
        body = re.split(r"^## ", text[m.end():], maxsplit=1, flags=re.M)[0]
        for line in body.splitlines():
            e = ADAPTED_ENTRY.match(line)
            if e:
                entries[e.group(1).strip()] = e.group(2).strip()
    return entries


def write_task_file(p: Project, t: dict) -> Path:
    path = p.root / "docs" / "tasks" / f"{t['id']}.md"
    if path.exists():
        text = path.read_text(encoding="utf-8")
        if CLAR_START in text and CLAR_END in text:
            head, rest = text.split(CLAR_START, 1)
            tail = rest.split(CLAR_END, 1)[1]
            path.write_text(head + clarifications_block(t) + tail, encoding="utf-8")
        return path
    template = (SATORY_HOME / "templates" / "task.md").read_text(encoding="utf-8")
    text = (template.replace("{{id}}", t["id"]).replace("{{title}}", t["title"])
            .replace("{{milestone}}", t.get("milestone") or "-").replace("{{owner}}", t["owner"])
            .replace("{{requirements}}", ", ".join(t.get("requirements", [])) or "-")
            .replace("{{depends_on}}", ", ".join(t.get("depends_on", [])) or "-")
            .replace("{{description}}", t["description"])
            .replace("{{acceptance}}", "\n".join(f"- [ ] {ac}" for ac in t["acceptance"]))
            .replace("{{clarifications}}", clarifications_block(t)))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    return path


# ----------------------------------------------------------------- deploy ---

def wait_health(url: str) -> bool:
    deadline = time.time() + HEALTH_TIMEOUT
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=5) as r:
                if 200 <= r.status < 400:
                    return True
        except (urllib.error.URLError, OSError):
            pass
        time.sleep(3)
    return False


def deploy(p: Project, env_name: str, image: str | None = None, label: str = "") -> dict:
    d = p.config.get("deploy") or {}
    e = d.get("environments", {}).get(env_name)
    if not e:
        return {"ok": True, "skipped": True}
    sha = p.git("rev-parse", "--short=12", "HEAD")
    log = p.logs / f"deploy-{env_name}-{label or sha}.log"
    if image is None:
        image = f"{d['image']}:{sha}"
        env = dict(p.env(), SATORY_IMAGE=image, SATORY_ENV=env_name)
        built = run_cmds(p, as_list(d.get("build")), log.with_suffix(".build.log"), env)
        if not built["ok"]:
            return {"ok": False, "stage": "build", "log": built["log"]}
    env = dict(p.env(), SATORY_IMAGE=image, SATORY_ENV=env_name)
    up = run_cmds(p, as_list(e["up"]), log, env)
    if not up["ok"]:
        return {"ok": False, "stage": "up", "log": up["log"], "image": image}
    health_url = e["url"].rstrip("/") + e.get("health", "")
    healthy = wait_health(health_url)
    previous = p.state.setdefault("deploy", {}).get(env_name, {})
    p.state["deploy"][env_name] = {"image": image, "sha": sha, "at": now(), "healthy": healthy,
                                   "previous": previous.get("image") if previous.get("image") != image
                                   else previous.get("previous")}
    p.save_state()
    return {"ok": healthy, "stage": "health" if not healthy else "done", "url": e["url"],
            "health_url": health_url, "image": image, "log": up["log"]}


# --------------------------------------------------------------- commands ---

def cmd_init(a) -> None:
    root = Path(a.dir).resolve()
    root.mkdir(parents=True, exist_ok=True)
    if not (root / ".git").exists():
        subprocess.run(["git", "init", "-q", "-b", "main"], cwd=root, check=True)
    has_commits = subprocess.run(["git", "rev-parse", "--verify", "-q", "HEAD"], cwd=root,
                                 capture_output=True).returncode == 0
    if not has_commits:  # empty clone: make sure the first commit lands on main
        subprocess.run(["git", "symbolic-ref", "HEAD", "refs/heads/main"], cwd=root, check=True)
    branch = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=root, capture_output=True,
                            text=True).stdout.strip() if has_commits else "main"
    for sub in ("docs/tasks", "docs/adr", ".satory/run/logs", ".claude"):
        (root / sub).mkdir(parents=True, exist_ok=True)
    tpl = SATORY_HOME / "templates"
    if not (root / ".satory" / "project.json").exists():
        cfg = json.loads((tpl / "project.json").read_text(encoding="utf-8"))
        cfg["name"] = a.name
        cfg["main_branch"] = branch or "main"
        write_json(root / ".satory" / "project.json", cfg)
    if not (root / ".satory" / "plan.json").exists():
        write_json(root / ".satory" / "plan.json", {"milestones": [], "tasks": []})
    for name, target in (("JOURNAL.md", "docs/JOURNAL.md"), ("CHANGELOG.md", "CHANGELOG.md")):
        if not (root / target).exists():
            shutil.copy(tpl / name, root / target)
    gitignore = root / ".gitignore"
    lines = gitignore.read_text(encoding="utf-8").splitlines() if gitignore.exists() else []
    wanted = [".satory/run/", "__pycache__/", "bin/", "obj/", "node_modules/", "test-results/",
              "playwright-report/", "*.secrets.env", ".env"]
    missing = [w for w in wanted if w not in lines]
    if missing:
        gitignore.write_text("\n".join([*lines, *missing]) + "\n", encoding="utf-8")
    settings_path = root / ".claude" / "settings.json"
    settings = load_json(settings_path, {})
    deny = settings.setdefault("permissions", {}).setdefault("deny", [])
    for rule in ("Read(./docs/JOURNAL.md)", "Read(./.satory/run/journal.pending.md)"):
        if rule not in deny:
            deny.append(rule)
    write_json(settings_path, settings)
    if a.git_name:
        subprocess.run(["git", "config", "user.name", a.git_name], cwd=root, check=True)
    if a.git_email:
        subprocess.run(["git", "config", "user.email", a.git_email], cwd=root, check=True)
    ident = subprocess.run(["git", "config", "user.email"], cwd=root, capture_output=True, text=True)
    emit({"ok": True, "root": str(root), "git_identity": bool(ident.stdout.strip())})


def cmd_workflow(p: Project, a) -> None:
    """Copy the kit's workflow script into the project, where the Workflow tool may run it from."""
    src = SATORY_HOME / "workflow" / "satory-build.js"
    dst = p.run / "satory-build.js"
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy(src, dst)
    shutil.rmtree(p.run / "sh", ignore_errors=True)  # captured steps of the previous run
    emit({"ok": True, "script": str(dst), "root": str(p.root)})


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except (PermissionError, OSError):
        return True
    return True


def cmd_wait(p: Project, a) -> None:
    """Wait for a step the workflow ran with captured output (`captured` in satory-build.js) and print its stdout.

    The runner's Bash call can move to the background and the runner may return before the step ends;
    the workflow then collects the real result here, in calls that stay below the Bash time limit.
    """
    if not re.fullmatch(r"[\w.-]+", a.id):
        raise SatoryError(f"invalid step id: {a.id}")
    base = p.run / "sh" / a.id
    pid_f, out_f, err_f, done_f = (base.with_name(f"{a.id}.{x}") for x in ("pid", "out", "err", "done"))
    deadline = time.monotonic() + a.timeout
    while not done_f.exists():
        if not pid_f.exists():
            return emit({"ok": False, "wait": "not_started", "error": f"step {a.id} never started"})
        pid = int(pid_f.read_text().strip() or 0)
        if not pid_alive(pid):
            if done_f.exists():  # finished between the two checks
                break
            tail = err_f.read_text(errors="replace")[-500:] if err_f.exists() else ""
            return emit({"ok": False, "wait": "died", "error": f"step {a.id} ended without an exit code: {tail}"})
        if time.monotonic() >= deadline:
            return emit({"ok": False, "wait": "pending"})
        time.sleep(5)
    out = out_f.read_text(encoding="utf-8", errors="replace") if out_f.exists() else ""
    if "{" not in out:
        tail = err_f.read_text(errors="replace")[-500:] if err_f.exists() else ""
        return emit({"ok": False, "error": f"step {a.id} exited with code {done_f.read_text().strip()} "
                                           f"without output: {tail}"})
    sys.stdout.write(out)


def cmd_where(p: Project, a) -> None:
    emit({"ok": True, "root": str(p.root), "name": p.config.get("name"), "branch": p.current_branch()})


def union(*lists) -> list:
    out = []
    for xs in lists:
        for x in xs or []:
            if x not in out:
                out.append(x)
    return out


def with_subtasks(item: dict) -> dict:
    """A task with `subtasks`: they are written into its description, and their acceptance criteria and
    questions are added to the task's, so Dev, the Reviewer and QA cover all of them in one cycle."""
    subs = item.get("subtasks") or []
    if not subs:
        return item
    parts = [str(item.get("description", "")).strip(),
             f"Subtasks ({len(subs)}) - all are done in this task, in one cycle (the mini-spec and the tests cover each):"]
    for i, st in enumerate(subs, 1):
        meta = [f"Acceptance: {', '.join(st.get('acceptance') or []) or '-'}"]
        if st.get("questions"):
            meta.append(f"Questions: {', '.join(st['questions'])}")
        parts.append(f"### Subtask {i} - {str(st.get('title', '')).strip()}\n\n"
                     f"{str(st.get('description', '')).strip()}\n\n{' · '.join(meta)}")
    return {**item, "description": "\n\n".join(x for x in parts if x),
            "acceptance": union(item.get("acceptance"), *[st.get("acceptance") for st in subs]),
            "questions": union(item.get("questions"), *[st.get("questions") for st in subs]),
            "subtasks": None}


def fold_tasks(items: list[dict], title: str | None = None, description: str = "") -> dict:
    """One task from several fixes planned for the same place in the plan: each becomes a subtask, so the
    whole cycle (review, staging, QA, UI, security, full e2e) runs once for all of them, not once for each."""
    subs = []
    for it in items:
        subs += it.get("subtasks") or [{"title": it.get("title", ""), "description": it.get("description", ""),
                                         "acceptance": it.get("acceptance") or [], "questions": it.get("questions") or []}]
    refs = union(*[it.get("refs") or [it.get("ref") or it.get("id")] for it in items])
    folded = {
        "ref": refs[0], "refs": refs, "title": title or "; ".join(str(it.get("title", "")).strip() for it in items),
        "milestone": items[0].get("milestone"), "insert_before": items[0].get("insert_before"),
        "owner": "devops" if all(it.get("owner") == "devops" for it in items) else "dev",
        "ui": any(it.get("ui", True) for it in items),
        "depends_on": [d for d in union(*[it.get("depends_on") for it in items]) if d not in refs],
        "requirements": union(*[it.get("requirements") for it in items]),
        "description": description, "acceptance": [], "questions": union(*[it.get("questions") for it in items]),
        "subtasks": subs}
    return with_subtasks(folded)


def bundle_items(items: list[dict]) -> list[dict]:
    """The planner's tasks for the same place (milestone and insert_before) become one task with subtasks."""
    groups: dict = {}
    for it in items:
        groups.setdefault((it.get("milestone"), it.get("insert_before") or ""), []).append(it)
    return [g[0] if len(g) == 1 else fold_tasks(g) for g in groups.values()]


def plan_merge(p: Project, plan: dict, reg: dict, status: dict, mg: dict) -> dict:
    """Merge tasks still to do into the earliest of them (its id stays); the others are removed and
    every reference to them points to the merged task."""
    tasks = plan["tasks"]
    ids = list(dict.fromkeys(mg.get("tasks") or []))
    if len(ids) < 2:
        raise SatoryError("merge needs at least two tasks")
    for x in ids:
        p.task(plan, x)
        if status[x] != "todo":
            raise SatoryError(f"{x} is {status[x]}; only tasks to do can be merged")
    parts = [t for t in tasks if t["id"] in ids]  # in plan order: the earliest keeps its id and place
    keep, gone = parts[0], {t["id"] for t in parts[1:]}
    folded = fold_tasks(parts, mg.get("title"), str(mg.get("description", "")).strip())
    for k in ("title", "owner", "ui", "requirements", "description", "acceptance", "questions"):
        keep[k] = folded[k]
    keep["extended"] = union(*[t.get("extended") for t in parts])
    if not keep["extended"]:
        keep.pop("extended")
    keep["depends_on"] = [d for d in union(*[t.get("depends_on") for t in parts]) if d not in ids]
    tasks[:] = [t for t in tasks if t["id"] not in gone]
    for t in tasks:
        if t is not keep:
            t["depends_on"] = [d for d in union([keep["id"] if d in gone else d for d in t.get("depends_on", [])])
                               if d != t["id"]]
    for q in reg["items"]:
        if q.get("task") in gone:
            q["task"] = keep["id"]
    return {"task": keep["id"], "merged": sorted(gone)}


def plan_patch(p: Project, plan: dict, reg: dict, data: dict) -> list[dict]:
    """Apply a plan change to `plan` and `reg` in memory and validate it: new milestones, new tasks (before
    `insert_before`, else ahead of everything still to do), additions to tasks still to do, extra
    dependencies, and the register items marked planned or resolved. Returns the new tasks."""
    tasks = plan["tasks"]
    status = {t["id"]: merged_status(p, t) for t in tasks}
    for m in data.get("milestones", []):
        ms = plan.setdefault("milestones", [])
        if any(x["id"] == m.get("id") for x in ms):
            raise SatoryError(f"milestone {m.get('id')} already exists")
        after = next((i for i, x in enumerate(ms) if x["id"] == m.get("after")), len(ms) - 1)
        ms.insert(after + 1, {"id": m["id"], "title": str(m.get("title", "")).strip()})
    num = 1 + max((int(t["id"].split("-")[1]) for t in tasks), default=0)
    cursor = next((i for i, t in enumerate(tasks) if status[t["id"]] == "todo"), len(tasks))
    added, refs = [], {}
    items = data.get("tasks", [])
    if data.get("bundle"):  # the planner's fixes: one task with subtasks per place in the plan
        items = bundle_items(items)
    for item in map(with_subtasks, items):
        tid = f"T-{num:03d}"
        num += 1
        for r in item.get("refs") or [item.get("ref") or tid]:
            refs[r] = tid
        task = {"id": tid, "title": str(item.get("title", "")).strip(), "milestone": item.get("milestone"),
                "owner": item.get("owner", "dev"), "ui": bool(item.get("ui", True)),
                "depends_on": list(item.get("depends_on") or []), "requirements": list(item.get("requirements") or []),
                "description": str(item.get("description", "")).strip(),
                "acceptance": [str(x) for x in item.get("acceptance") or []],
                "questions": [str(x) for x in item.get("questions") or []], "status": "todo"}
        # before the named task to do; else a task for a later milestone goes after the tasks of its milestone
        # and the ones before it, any other ahead of everything still to do (after the tasks added so far)
        before = item.get("insert_before")
        pos = next((i for i, t in enumerate(tasks) if t["id"] == before and status[t["id"]] == "todo"), None)
        if pos is None:
            order = {m["id"]: i for i, m in enumerate(plan.get("milestones", []))}
            current = tasks[cursor].get("milestone") if cursor < len(tasks) else None
            mine = order.get(task["milestone"], -1)
            if mine > order.get(current, mine):
                pos = 1 + max((i for i, t in enumerate(tasks) if order.get(t.get("milestone"), -1) <= mine), default=-1)
            else:
                pos = cursor
        tasks.insert(pos, task)
        status[tid] = "todo"
        if pos <= cursor:
            cursor += 1
        added.append(task)
    def resolve(d: str) -> str:
        # a new task by its ref, or the task that covers a question (e.g. one added by an earlier queued change)
        if d in refs:
            return refs[d]
        if re.fullmatch(r"Q-\d+", d):
            by_q = [t["id"] for t in tasks if d in t.get("questions", [])]
            if not by_q:
                raise SatoryError(f"no task covers {d}")
            return by_q[0]
        return d

    for t in added:  # dependencies may name other new tasks by their ref
        t["depends_on"] = [d for d in union([resolve(d) for d in t["depends_on"]]) if d != t["id"]]
    for up in data.get("updates", []):
        t = p.task(plan, up.get("task", ""))
        if status[t["id"]] != "todo":
            raise SatoryError(f"{t['id']} is {status[t['id']]}; only tasks to do can be changed")
        if up.get("description_append"):
            t["description"] = f"{t['description'].rstrip()}\n\n{str(up['description_append']).strip()}"
        for k in ("acceptance", "requirements", "questions"):
            for x in up.get(f"{k}_add", []):
                if x not in t.setdefault(k, []):
                    t[k].append(x)
        for x in up.get("questions_add", []):  # the task was planned before; these questions extend it
            if x not in t.setdefault("extended", []):
                t["extended"].append(x)
    known = {q["id"] for q in reg["items"]}
    for ln in data.get("links", []):  # only names where a task comes from (the Source column), any status
        t = p.task(plan, ln.get("task", ""))
        for x in ln.get("questions", []):
            if x not in known:
                raise SatoryError(f"links: no question {x}")
            for k in ("questions", "extended") if ln.get("extended") else ("questions",):
                if x not in t.setdefault(k, []):
                    t[k].append(x)
    for dep in data.get("depends", []):
        t = p.task(plan, dep.get("task", ""))
        if status[t["id"]] not in ("todo", "blocked"):
            # a task in progress or done is not held back: it finishes first and the new tasks come after it
            data.setdefault("_skipped_depends", []).append(f"{t['id']} ({status[t['id']].replace('_', ' ')})")
            continue
        for d in dep.get("add", []):
            d = resolve(d)
            if d not in t.setdefault("depends_on", []):
                t["depends_on"].append(d)
    data["_merged"] = [plan_merge(p, plan, reg, status, mg) for mg in data.get("merge", [])]
    errors = validate_plan(plan)
    if errors:
        raise SatoryError("the new plan is invalid: " + "; ".join(errors))
    for t in added + [p.task(plan, up["task"]) for up in data.get("updates", [])]:
        for qid in t.get("questions", []):
            q = question_find(reg, qid)
            if q["status"] in ("open", "deferred", "answered"):
                q["status"], q["task"] = "planned", t["id"]
    for r in data.get("resolved", []):
        q = question_find(reg, r.get("id", ""))
        q["status"], q["resolution"] = "resolved", str(r.get("reason", "")).strip()
    return added


def plan_add(p: Project, plan: dict, data: dict, source: str = "planner") -> dict:
    """Apply a plan change on a clean main and commit it with the journal and the register."""
    if p.current_branch() != p.main:
        raise SatoryError(f"plan add runs only on {p.main} (between tasks); use --queue")
    if p.dirty():
        raise SatoryError(f"{p.main} has uncommitted changes")
    reg = questions_load(p)
    added = plan_patch(p, plan, reg, data)
    p.save_plan(plan)
    questions_save(p, reg)
    lines = [f"- {t['id']} ({t['milestone']}): {t['title']} - for {', '.join(t['questions']) or '-'}" for t in added]
    lines += [f"- {up['task']} extended" + (f" - for {', '.join(up.get('questions_add', []))}" if up.get("questions_add") else "")
              for up in data.get("updates", [])]
    lines += [f"- {ln['task']} comes from {', '.join(ln.get('questions', []))}" for ln in data.get("links", [])]
    lines += [f"- {m['task']} merged with {', '.join(m['merged'])}" for m in data.get("_merged", [])]
    lines += [f"- new milestone {m['id']}: {m.get('title', '')}" for m in data.get("milestones", [])]
    lines += [f"- {r.get('id')}: no task - {r.get('reason', '')}" for r in data.get("resolved", [])]
    lines += [f"- {x}: already started or done - no new dependency" for x in data.get("_skipped_depends", [])]
    linked = ux_link_tasks(p, added)
    if linked:
        lines += [f"- UX problems planned: {', '.join(linked)}"]
    journal_pending(p, "plan", source, None, "ok", join_note(data.get("summary", ""), lines))
    journal_flush(p)
    render_plan(p, plan)
    p.git("add", "-A")
    changed = [t["id"] for t in added] + [up["task"] for up in data.get("updates", [])]
    changed += [ln["task"] for ln in data.get("links", []) if ln["task"] not in changed]
    changed += [f"{m['task']} + {', '.join(m['merged'])}" for m in data.get("_merged", [])]
    p.git("commit", "-q", "-m", f"chore(plan): {data.get('title') or 'tasks for answered questions'} ({', '.join(changed) or 'no tasks'})"
                                f"\n\n{TRAILER}")
    push_error = push_quiet(p, "origin", p.main)
    return {"ok": True, "added": [t["id"] for t in added], "updated": [up["task"] for up in data.get("updates", [])],
            "merged": data.get("_merged", []),
            "resolved": [r.get("id") for r in data.get("resolved", [])], "push_error": push_error,
            "skipped_depends": data.get("_skipped_depends", [])}


def queue_dir(p: Project) -> Path:
    return p.run / "queue"


def queue_apply_one(p: Project, item: dict, name: str) -> dict:
    """On a clean main: merge the item's branch (documents), then apply its plan change."""
    data, branch = item.get("data") or {}, item.get("branch")
    qids = {x for t in data.get("tasks", []) for x in t.get("questions", [])}
    qids |= {x for up in data.get("updates", []) for x in up.get("questions_add", [])}
    reg = questions_load(p)
    if qids and all(any(q["id"] == x and q["status"] in ("planned", "resolved") for q in reg["items"]) for x in qids):
        data = {"links": data["links"]} if data.get("links") else {}  # already planned: documents and links remain
    res = {"file": name, "branch": branch, "merged": False, "added": [], "updated": [], "resolved": []}
    if branch:
        if not p.branch_exists(branch):
            raise SatoryError(f"branch {branch} of the queued change is gone")
        # a real merge (not squash): the next queued branch is built on this one and must see it as merged
        before = p.git("rev-parse", "HEAD")
        r = p.git("merge", "--no-ff", "-q", "-m", f"{item.get('message') or f'docs: {branch}'}\n\n{TRAILER}",
                  branch, check=False)
        if r.returncode != 0:
            p.git("merge", "--abort", check=False)
            p.git("reset", "-q", "--hard", before)
            raise SatoryError(f"merge of {branch} failed: {(r.stderr or r.stdout).strip()[:300]}")
        res["merged"] = p.git("rev-parse", "HEAD") != before
    if any(data.get(k) for k in ("tasks", "updates", "milestones", "depends", "resolved", "links", "merge")):
        res.update(plan_add(p, p.plan(), data, item.get("source", "request")))
    if branch:
        p.git("branch", "-D", branch)
    res["push_error"] = push_quiet(p, "origin", p.main)
    progress(p, f"🗂 queued change applied: {item.get('message') or name}")
    return res


# The non-blocking findings (minor/nit of the Reviewer and the UI reviewer, low/info of Security) of the
# passing round of every task: they become one polish task after the milestone instead of being forgotten.

def cmd_polish(p: Project, a) -> None:
    path = p.run / "polish.json"
    reg = load_json(path, {"items": []})
    if a.action == "add":
        try:
            new = json.loads(sys.stdin.read() or "[]")
        except json.JSONDecodeError as e:
            raise SatoryError(f"polish add expects a JSON list on stdin: {e}")
        seen = {(x["source"], x["issue"]) for x in reg["items"]}
        added = 0
        for item in new:
            issue = str(item.get("issue", "")).strip()
            if not issue or (a.source or "", issue) in seen:
                continue
            reg["items"].append({"task": a.task, "source": a.source or "", "severity": str(item.get("severity", "")),
                                 "where": str(item.get("where", "")), "issue": issue,
                                 "fix": str(item.get("fix", "")).strip(), "planned": None})
            added += 1
        write_json(path, reg)
        if added:
            progress(p, f"🧽 {added} small improvement(s) from {a.source} noted for the polish task")
        return emit({"ok": True, "added": added})
    if a.action == "list":
        items = [x for x in reg["items"] if not x.get("planned")]
        return emit({"ok": True, "items": items, "count": len(items)})
    if a.action == "planned":
        for x in reg["items"]:
            if not x.get("planned"):
                x["planned"] = a.task
        write_json(path, reg)
        return emit({"ok": True})


# The design of the app (docs/design/: AUDIT.md, DESIGN.md, mockups): the build runs the design step at a
# boundary between tasks when the app has a UI but no design yet, or when the user asks for a new one.

def cmd_design(p: Project, a) -> None:
    req = p.run / "design.request.json"
    if a.action == "request":
        brief = read_note(a).strip()
        write_json(req, {"requested": now(), "brief": brief, "choice": a.choice or None})
        progress(p, f"🎨 design requested{f' (direction {a.choice})' if a.choice else ''}: the build runs it at the next boundary")
        return emit({"ok": True})
    if a.action == "log":
        progress(p, f"🎨 {read_note(a).strip()}")
        return emit({"ok": True})
    if a.action == "done":
        if req.exists():
            req.unlink()
        return emit({"ok": True})
    design = p.root / "docs" / "design"
    directions = sorted(x.name for x in (design / "directions").iterdir() if x.is_dir()) if (design / "directions").is_dir() else []
    mockups = sorted(x.name for x in (design / "mockups").glob("*.html")) if (design / "mockups").is_dir() else []
    emit({"ok": True, "has_design": (design / "DESIGN.md").exists(), "request": load_json(req, {}) or None,
          "directions": directions, "mockups": mockups})


def cmd_queue(p: Project, a) -> None:
    """Changes to main while a task runs (documents on their own branch + a plan change) wait here and are
    applied between two tasks, in order. With no task running, on a clean main, they are applied at once."""
    qd = queue_dir(p)
    files = sorted(qd.glob("*.json")) if qd.exists() else []
    free = p.current_branch() == p.main and not p.dirty()
    if a.action == "begin":
        # a worktree of main on a new branch, outside the project, for the documents of the change
        import tempfile
        branch = f"satory/queue-{now('%Y%m%d-%H%M%S')}-{os.getpid()}"
        wdir = tempfile.mkdtemp(prefix="satory-queue-")
        os.rmdir(wdir)
        # on top of the last queued change, so the queued documents build on each other and merge in order
        waiting = [b for b in (load_json(x).get("branch") for x in files) if b and p.branch_exists(b)]
        base = waiting[-1] if waiting else p.main
        p.git("worktree", "add", "-q", "-b", branch, wdir, base)
        return emit({"ok": True, "branch": branch, "dir": wdir, "base": base})
    if a.action == "add":
        try:
            data = json.loads(read_note(a) or "{}")
        except json.JSONDecodeError as e:
            raise SatoryError(f"queue add expects JSON on stdin: {e}")
        message = a.message or f"docs: {a.source or 'change'}"
        if a.dir:  # commit the documents edited in the worktree and remove it; the branch stays
            d = Path(a.dir)
            subprocess.run(["git", "-C", str(d), "add", "-A"], check=True)
            if subprocess.run(["git", "-C", str(d), "diff", "--cached", "--quiet"]).returncode != 0:
                subprocess.run(["git", "-C", str(d), "commit", "-q", "-m", f"{message}\n\n{TRAILER}"], check=True)
            p.git("worktree", "remove", "--force", str(d))
        import copy
        # check it now, on the plan as it will be after the changes already waiting in the queue
        sim_plan, sim_reg = copy.deepcopy(p.plan()), copy.deepcopy(questions_load(p))
        for x in files:
            plan_patch(p, sim_plan, sim_reg, load_json(x).get("data") or {})
        plan_patch(p, sim_plan, sim_reg, copy.deepcopy(data))  # the check must not change what is queued
        item = {"source": a.source or "request", "branch": a.branch, "message": message, "data": data}
        if free and not files:
            return emit({"ok": True, "applied": queue_apply_one(p, item, "now")})
        qd.mkdir(parents=True, exist_ok=True)
        path = qd / f"{now('%Y%m%d-%H%M%S')}-{os.getpid()}.json"
        write_json(path, item)
        return emit({"ok": True, "queued": p.rel(path)})
    if a.action == "list":
        return emit({"ok": True, "items": [{"file": f.name, **load_json(f)} for f in files]})
    if a.action == "apply":
        if files and (p.current_branch() != p.main or p.dirty()):
            return emit({"ok": True, "applied": [], "waiting": len(files), "note": f"applied on a clean {p.main}"})
        applied, errors = [], []
        for path in files:
            try:
                applied.append(queue_apply_one(p, load_json(path), path.name))
                path.unlink()
            except SatoryError as e:
                errors.append(f"{path.name}: {e}")
                break  # keep the order: the later items wait for this one
        return emit({"ok": not errors, "applied": applied, "errors": errors, "waiting": len(files) - len(applied)})


def cmd_plan(p: Project, a) -> None:
    plan = p.plan()
    if a.action == "add":
        try:
            data = json.loads(read_note(a) or "{}")
        except json.JSONDecodeError as e:
            raise SatoryError(f"plan add expects JSON on stdin: {e}")
        return emit(plan_add(p, plan, data, a.source or "planner"))
    if a.action == "validate":
        errors = validate_plan(plan)
        emit({"ok": not errors, "errors": errors, "tasks": len(plan["tasks"])})
    elif a.action == "render":
        render_plan(p, plan)
        emit({"ok": True, "path": "docs/PLAN.md"})
    else:
        errors = validate_plan(plan)
        by_id = {q["id"]: q for q in questions_load(p)["items"]}
        emit({"ok": not errors, "errors": errors, "root": str(p.root), "name": p.config.get("name"),
              "max_rounds": p.config.get("max_rounds", 33),
              "has_deploy": bool(p.config.get("deploy", {}).get("environments", {}).get("staging")),
              "ui_review": bool(p.config.get("ui", {}).get("review")),
              "language": p.config.get("language", "en"),
              "experimental": sorted(p.config.get("experimental", {})),
              "milestone_review": p.config.get("milestone_review", True) is not False,
              "milestones_reviewed": questions_load(p)["milestones_reviewed"],
              "ux_reviewed": questions_load(p)["ux_reviewed"],
              "code_health_review": p.config.get("code_health_review", True) is not False,
              "ux_review": p.config.get("ux_review", True) is not False,
              "polish_task": p.config.get("polish_task", True) is not False,
              "design_step": p.config.get("design_step", True) is not False,
              "has_design": (p.root / "docs" / "design" / "DESIGN.md").exists(),
              "design_request": load_json(p.run / "design.request.json", {}) or None,
              "critical_questions_gate": p.config.get("critical_questions_gate", True) is not False,
              "milestones": plan.get("milestones", []),
              "tasks": [{"id": t["id"], "title": t["title"], "owner": t["owner"],
                         "milestone": t.get("milestone"), "depends_on": t.get("depends_on", []), "ui": t.get("ui"),
                         "source": task_source(t, by_id), "status": merged_status(p, t)} for t in plan["tasks"]]})


def cmd_task_start(p: Project, a) -> None:
    tid, branch = a.task, f"satory/{a.task}"
    plan = p.plan()
    t = p.task(plan, tid)
    st = p.state["tasks"].get(tid)
    resumed = False
    if st and p.branch_exists(branch):
        if p.current_branch() != branch:
            if p.dirty():
                raise SatoryError("working tree is dirty; commit or stash before starting a task")
            p.git("checkout", "-q", branch)
        elif p.dirty():
            st["checkpoint"] = checkpoint(p, tid, "resume (uncommitted work)")
        main_head = p.git("rev-parse", p.main)
        if p.git("merge-base", p.main, branch) != main_head:
            r = p.git("rebase", "-q", p.main, check=False)
            if r.returncode != 0:
                p.git("rebase", "--abort", check=False)
                p.git("branch", "-m", branch, f"{branch}-stale-{now('%Y%m%d%H%M%S')}")
                p.git("checkout", "-q", p.main)
                st = None
        if st:
            st["base"] = main_head
            write_task_file(p, t)
            st["checkpoint"] = checkpoint(p, tid, "resume")
            resumed = True
    if not resumed:
        if p.current_branch() != p.main:
            if p.dirty():
                raise SatoryError("working tree is dirty; commit or stash before starting a task")
            p.git("checkout", "-q", p.main)
        if p.dirty():
            raise SatoryError(f"{p.main} has uncommitted changes; commit them before starting a task")
        if p.branch_exists(branch):
            p.git("branch", "-m", branch, f"{branch}-stale-{now('%Y%m%d%H%M%S')}")
        base = p.git("rev-parse", "HEAD")
        p.git("checkout", "-q", "-b", branch)
        listed, names = test_names(p, tid, cache=True)  # the new branch is main's state here
        write_task_file(p, t)
        st = {"branch": branch, "base": base, "rounds": (st or {}).get("rounds", 0),
              "known_tests": sorted(names), "test_list_ok": listed, "started": now()}
        st["checkpoint"] = checkpoint(p, tid, "start")
    if not resumed:  # a fresh start: the notes and the digest of an abandoned branch would mislead
        for f in [*(p.run / "notes").glob(f"{tid}-*.md"), p.run / "context" / f"{tid}.md",
                  findings_path(p, tid), p.run / "findings" / f"{tid}.md"]:
            f.unlink(missing_ok=True)
        shutil.rmtree(p.run / "findings" / tid, ignore_errors=True)
    for k in ("reviewer", "ui", "security", "qa"):  # check notes of 1.4.x; the findings are in the register now
        (st.get("reviews") or {}).pop(k, None)
    p.state["tasks"][tid] = st
    p.save_state()
    open_findings = []
    if resumed:
        still = [f for f in findings_load(p, tid)["items"] if f["status"] in FINDING_OPEN]
        still.sort(key=lambda f: not finding_blocks(f))
        for stage in dict.fromkeys(f["stage"] for f in still):
            mine = [f for f in still if f["stage"] == stage]
            open_findings.append({"stage": stage, "round": max(f["round"] for f in mine), "verdict": "open findings",
                                  "note": "\n".join(f"- {finding_line(f)}" + ("" if finding_blocks(f) else " (optional)") for f in mine)})
        open_findings += [{"stage": k, **v} for k, v in (st.get("reviews") or {}).items() if v.get("verdict") in REVIEW_FAIL]
    context_error = refresh_context(p, tid)
    again = f" (resumed, {st['rounds']} round(s) used)" if resumed else ""
    progress(p, f"▶ {tid}{again} - {t['title']}")
    emit({"ok": True, "task": tid, "branch": branch, "base": st["base"], "checkpoint": st["checkpoint"],
          "rounds_used": st["rounds"], "resumed": resumed, "task_file": f"docs/tasks/{tid}.md",
          "known_tests": len(st["known_tests"]), "open_findings": open_findings, "context_error": context_error})


# ---------------------------------------------------------- context digest ---

# Ids of requirements a task refers to (R-012, NFR-006, AC-004.2, UC-3 ...); task and question ids are not.
REQ_ID = re.compile(r"\b(?!(?:T|Q|ADR)-)[A-Z]{1,5}-\d{1,3}(?:\.\d{1,3})?(?!\d|\.\d)")
REQ_RANGE = re.compile(r"\b([A-Z]{1,5}-\d{1,3})\.(\d{1,3})(?:\s*[-\u2013]\s*\1\.|[-\u2013])(\d{1,3})\b")
REQ_WILD = re.compile(r"\b([A-Z]{1,5}-\d{1,3})\.\*")
ADR_ID = re.compile(r"\bADR-(\d{1,4})\b")
DIGEST_DOCS = ["docs/SPEC.md", "docs/ARCHITECTURE.md", "docs/UI.md", "docs/design/DESIGN.md"]
HEADING = re.compile(r"^(#{1,4})\s+(.*\S)\s*$")


def headings(lines: list[str]) -> list[tuple[int, int, str]]:
    """(index, level, text) of the markdown headings, outside fenced code blocks."""
    out, fence = [], False
    for i, line in enumerate(lines):
        if line.lstrip().startswith("```"):
            fence = not fence
            continue
        m = None if fence else HEADING.match(line)
        if m:
            out.append((i, len(m.group(1)), m.group(2)))
    return out


ID_HEAD = re.compile(r"^([A-Z]{1,5}-\d{1,3})\s+-\s+(.+)$")
ID_BULLET = re.compile(r"^(\s*)[-*]\s+\*\*([A-Z]{1,5}-\d{1,3}(?:\.\d{1,3})?)\b(.*?)\*\*")
NOT_REQ = ("T", "Q", "ADR")


def bullet_end(lines: list[str], i: int, indent: int) -> int:
    """The end (exclusive) of the bullet at line i: its continuation and nested lines, up to a blank line,
    a heading or a sibling bullet."""
    end = i + 1
    while end < len(lines) and lines[end].strip():
        ln = lines[end]
        if HEADING.match(ln) or (re.match(r"^\s*[-*]\s", ln) and len(ln) - len(ln.lstrip()) <= indent):
            break
        end += 1
    return end


def parse_spec(lines: list[str], cross: tuple[str, ...] = ("NFR",), crit: tuple[str, ...] = ("AC",)) -> dict:
    """The requirements model of docs/SPEC.md, independent of its wording. The format (checked by `satory spec
    check`): a requirement is a heading `### R-001 - Title` with its criteria as bullets `- **AC-001.1** - ...`
    under it; a cross-cutting requirement (prefix NFR by default) is a bullet `- **NFR-001 - Title.** ...` or a
    heading `### NFR-001 - Title`. Returns the items (id, kind, title, parent, start, end; 0-based lines,
    end exclusive), the top-level sections and the format errors and warnings."""
    heads = headings(lines)
    items: list[dict] = []
    errors: list[str] = []
    warnings: list[str] = []
    reqs = []  # requirement headings: (start, end, id)
    head_prefixes = {m.group(1).split("-")[0] for _, _, h in heads if (m := ID_HEAD.match(h))} - set(NOT_REQ)
    id_prefixes = head_prefixes | set(cross) | set(crit)
    for k, (i, level, text) in enumerate(heads):
        m = ID_HEAD.match(text)
        lead = REQ_ID.match(text)
        if not m and lead and lead.group(0).split("-")[0] in id_prefixes:
            errors.append(f"line {i + 1}: heading {text[:60]!r} starts with an id but is not `### <ID> - Title`"
                          + (" (a criterion is a bullet `- **AC-001.1** - ...`)" if "." in lead.group(0) else ""))
        if not m or m.group(1).split("-")[0] in NOT_REQ:
            continue
        rid = m.group(1)
        end = next((j for j, lv, _ in heads[k + 1:] if lv <= level), len(lines))
        kind = "cross" if rid.split("-")[0] in cross else "requirement"
        items.append({"id": rid, "kind": kind, "title": m.group(2).strip(), "parent": None, "start": i, "end": end})
        if kind == "requirement":
            reqs.append((i, end, rid))
    req_prefixes = {rid.split("-")[0] for _, _, rid in reqs}
    known_prefixes = req_prefixes | set(cross) | set(crit)
    fence = False
    for i, line in enumerate(lines):
        if line.lstrip().startswith("```"):
            fence = not fence
            continue
        if fence:
            continue
        num = re.match(r"^\s*\d+[.)]\s+\*\*([A-Z]{1,5}-\d{1,3}(?:\.\d{1,3})?)\b", line)
        if num and num.group(1).split("-")[0] in known_prefixes:
            errors.append(f"line {i + 1}: {num.group(1)} is in a numbered list; write it as a bullet `- **{num.group(1)}** - ...`")
        m = ID_BULLET.match(line)
        if m and m.group(2).split("-")[0] not in known_prefixes and m.group(2).split("-")[0] not in NOT_REQ \
                and re.match(r"\s+-\s", m.group(3) or "") and "." not in m.group(2):
            warnings.append(f"line {i + 1}: {m.group(2)} looks like a requirement, but the SPEC does not use the prefix "
                            f"{m.group(2).split('-')[0]} (a typo?)")
        if not m or m.group(2).split("-")[0] not in known_prefixes:
            continue  # other bold words (SHA-256, TLS-1.2, Q-001, T-010) are not requirements
        bid, indent = m.group(2), len(m.group(1))
        title = re.sub(r"^\s*-\s*", "", m.group(3)).strip().rstrip(".") or line[m.end():].strip(" -")[:120]
        end = bullet_end(lines, i, indent)
        parent = next((rid for a0, b0, rid in reversed(reqs) if a0 < i < b0), None)
        if "." in bid:
            if bid.split("-")[0] not in crit:
                errors.append(f"line {i + 1}: {bid} - criteria use the prefix {'/'.join(crit)} (spec.criterion_prefixes)")
                continue
            if not parent:
                errors.append(f"line {i + 1}: criterion {bid} is not under a requirement heading")
            elif int(bid.split(".")[0].split("-")[1]) != int(parent.split("-")[1]):
                warnings.append(f"line {i + 1}: criterion {bid} is under {parent} (numbers differ)")
            items.append({"id": bid, "kind": "criterion", "title": title, "parent": parent, "start": i, "end": end})
        elif bid.split("-")[0] in crit:
            errors.append(f"line {i + 1}: {bid} - a criterion id has the requirement's number and its own: `AC-001.1`")
            continue
        else:
            kind = "cross" if bid.split("-")[0] in cross else "requirement"
            if kind == "requirement":
                warnings.append(f"line {i + 1}: requirement {bid} is a bullet; write it as a heading `### {bid} - Title`")
            items.append({"id": bid, "kind": kind, "title": title, "parent": parent, "start": i, "end": end})
    seen: dict[str, int] = {}
    for it in items:
        if it["id"] in seen:
            errors.append(f"line {it['start'] + 1}: {it['id']} is defined twice (also line {seen[it['id']] + 1})")
        seen.setdefault(it["id"], it["start"])
    for a0, b0, rid in reqs:
        if not any(it["parent"] == rid for it in items):
            warnings.append(f"line {a0 + 1}: requirement {rid} has no acceptance criteria")
    tops = [(i, txt) for i, lv, txt in heads if lv == 2]
    sections = []
    for k, (i, txt) in enumerate(tops):
        end = tops[k + 1][0] if k + 1 < len(tops) else len(lines)
        sections.append({"title": txt, "start": i, "end": end,
                         "items": sum(1 for it in items if i <= it["start"] < end)})
    items.sort(key=lambda it: it["start"])
    return {"items": items, "sections": sections, "errors": errors, "warnings": warnings}


def cross_prefixes(p: Project) -> tuple[str, ...]:
    return tuple(p.config.get("spec", {}).get("cross_cutting_prefixes") or ["NFR"])


def crit_prefixes(p: Project) -> tuple[str, ...]:
    return tuple(p.config.get("spec", {}).get("criterion_prefixes") or ["AC"])


def spec_model(p: Project, lines: list[str]) -> dict:
    return parse_spec(lines, cross_prefixes(p), crit_prefixes(p))


def task_req_ids(t: dict, model: dict, wildcards: bool = True) -> list[str]:
    """The requirement ids a task refers to, in order: its `requirements`, then every id in its text, with
    ranges ("AC-003.8 - AC-003.10") and wildcards ("AC-003.*") expanded. An id the SPEC does not define is
    kept when the task lists it or its prefix is one the SPEC uses, so the digest reports it as not found."""
    subs = t.get("subtasks") or []
    text = "\n".join([t.get("title") or "", t.get("description") or "", *(t.get("acceptance") or []),
                      *[f"{x.get('title') or ''}\n{x.get('description') or ''}\n" + "\n".join(x.get("acceptance") or [])
                        for x in subs]])
    known = [it["id"] for it in model["items"]]
    prefixes = {x.split("-")[0] for x in known}
    explicit = list(t.get("requirements") or [])
    found: list[str] = []
    for m in REQ_RANGE.finditer(text):
        lo, hi = int(m.group(2)), int(m.group(3))
        if lo <= hi <= lo + 50:
            found += [f"{m.group(1)}.{n}" for n in range(lo, hi + 1)]
    for m in REQ_WILD.finditer(text):
        matches = [x for x in known if x.startswith(m.group(1) + ".")]
        found += matches if wildcards else sorted({it["parent"] for it in model["items"]
                                                   if it["id"] in matches and it.get("parent")})
    found += REQ_ID.findall(REQ_WILD.sub(" ", text))
    # an id the SPEC does not define but with a prefix it uses is kept, so the digest reports it as not found
    return list(dict.fromkeys([*explicit, *(x for x in found if x.split("-")[0] in prefixes)]))


def spec_sections(lines: list[str], ids: list[str], model: dict | None = None) -> tuple[list[tuple[int, int]], list[str]]:
    """Line ranges of the SPEC text for the ids (a requirement with its whole section, a criterion or a
    cross-cutting item with its paragraph), merged and in document order, and the ids not found."""
    model = model or parse_spec(lines)
    by_id: dict[str, dict] = {}
    for it in model["items"]:
        by_id.setdefault(it["id"], it)  # the first definition wins over a later duplicate
    ranges, missing = [], []
    for rid in ids:
        it = by_id.get(rid)
        if not it:
            missing.append(rid)
            continue
        ranges.append((it["start"], it["end"]))
        par = by_id.get(it.get("parent") or "")
        if it["kind"] == "criterion" and par:  # the requirement's heading and story give the criterion its context
            first = min((x["start"] for x in model["items"] if x.get("parent") == par["id"]), default=par["start"] + 1)
            ranges.append((par["start"], first))
    merged: list[tuple[int, int]] = []
    for a0, b0 in sorted(ranges):
        if merged and a0 <= merged[-1][1]:
            merged[-1] = (merged[-1][0], max(merged[-1][1], b0))
        else:
            merged.append((a0, b0))
    return merged, missing


def doc_toc(lines: list[str]) -> list[str]:
    """Headings of levels 2-3 with their line numbers (1-based), for reading a document by section."""
    return [f"{'  ' if level == 3 else ''}- L{i + 1}: {text}" for i, level, text in headings(lines) if level in (2, 3)]


REVIEW_FAIL = ("fail", "changes_requested", "gate-fail")


def spec_cross_cutting(lines: list[str], model: dict, skip: list[str] = ()) -> list[str]:
    """The parts of the SPEC that apply to every task: the cross-cutting requirements (NFRs) in full, and the
    top-level sections without requirements (roles, data, out of scope, assumptions ...) by name and line, to
    read the ones that concern the task."""
    ids = [it["id"] for it in model["items"] if it["kind"] == "cross" and it["id"] not in skip]
    out = []
    if ids:
        ranges, _ = spec_sections(lines, ids, model)
        out += ["## Requirements for every task (full text from docs/SPEC.md"
                + (", without those already above)" if skip else ")"), ""]
        for a0, b0 in ranges:
            out += [f"<!-- docs/SPEC.md lines {a0 + 1}-{b0} -->", *lines[a0:b0], ""]
    named = [f"- L{sec['start'] + 1}: {sec['title']}" for sec in model["sections"] if not sec["items"]]
    if named:
        out += ["## Other sections of docs/SPEC.md - read the ones that concern the task", "", *named, ""]
    return out


def write_context(p: Project, tid: str) -> dict:
    """Writes the context digest of a task to .satory/run/context/<task>.md: the full text of the
    requirements it refers to, the tables of contents of the documents with line numbers (to read them by
    section), the ADRs and mockups it names, the files changed on its branch, the agents' notes and the last
    findings of each review. The CLI rewrites it whenever the work changes (task start, after Dev, after QA,
    after each review), so every agent sees the current state. The documents stay the source of truth."""
    out = p.run / "context" / f"{tid}.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.unlink(missing_ok=True)  # a failed rewrite never leaves the previous round's digest behind
    t = p.task(p.plan(), tid)
    st = p.state["tasks"].get(tid) or {}
    parts = [f"# Context digest - {tid}: {t.get('title', '')}", "",
             "Written by satory whenever the work on the task changes. It is a map, not a replacement: the "
             "documents remain the source of truth. Read a document by section (Read with offset/limit from the "
             "line numbers below) and the whole of it only when the task really spans it.", ""]
    ids, missing = [], []
    spec = p.root / "docs" / "SPEC.md"
    if spec.exists():
        lines = spec.read_text(encoding="utf-8").splitlines()
        model = spec_model(p, lines)
        ids = task_req_ids(t, model)
        if ids:
            ranges, missing = spec_sections(lines, ids, model)
            parts += [f"## Requirements of this task (text from docs/SPEC.md: {', '.join(ids)})", ""]
            for a0, b0 in ranges:
                parts += [f"<!-- docs/SPEC.md lines {a0 + 1}-{b0} -->", *lines[a0:b0], ""]
            if missing:
                parts += [f"Not found in docs/SPEC.md: {', '.join(missing)}", ""]
        parts += spec_cross_cutting(lines, model, ids)
    if spec.exists() and ids:
        try:
            cov = [c for c in compute_coverage(p, model)["items"] if c["id"] in ids or c.get("parent") in ids]
            if cov:  # the task's criteria and the NFRs it names
                parts += ["## Coverage of the task's criteria (tests that already check them)", "",
                          "A test checks a criterion as it was when the test was written: a criterion this task "
                          "changes (see the change history of docs/SPEC.md) needs its tests updated or new ones.", "",
                          *[f"- {coverage_line(c)}" for c in cov], ""]
        except Exception:  # noqa: BLE001 - the coverage is a help, never a reason to fail the digest
            pass
    parts += ["## Tables of contents", ""]
    for rel in DIGEST_DOCS:
        f = p.root / rel
        if f.exists():
            lines = f.read_text(encoding="utf-8").splitlines()
            parts += [f"### {rel} ({len(lines)} lines)", *doc_toc(lines), ""]
    text = "\n".join([t.get("description") or "", *(t.get("acceptance") or []),
                      *[f"{x.get('description') or ''}" for x in (t.get("subtasks") or [])]])
    adr_dir = p.root / "docs" / "adr"
    adrs = [f for n in dict.fromkeys(ADR_ID.findall(text)) for f in sorted(adr_dir.glob(f"{int(n):03d}-*.md"))[:1]] \
        if adr_dir.is_dir() else []
    if adrs:
        parts += ["## ADRs named by the task", "", *[f"- {p.rel(f)}" for f in adrs], ""]
    mdir = p.root / "docs" / "design" / "mockups"
    if mdir.is_dir():
        pages = sorted(x.name for x in mdir.glob("*.html"))
        named = [x for x in pages if re.search(rf"(?<![\w-]){re.escape(x)}", text)]
        parts += ["## Mockups (docs/design/mockups/)", ""]
        if named:
            parts += ["Named by the task: " + ", ".join(named)]
        parts += ["All pages: " + ", ".join(pages), ""]
    if st.get("base"):
        changed = [x for x in p.git("diff", "--name-only", st["base"]).splitlines()
                   + p.git("ls-files", "--others", "--exclude-standard").splitlines()
                   if x and not x.startswith((".satory/", "docs/tasks/"))]
        changed = list(dict.fromkeys(changed))
        if changed:
            parts += [f"## Files changed on this task's branch so far ({len(changed)})", "",
                      *[f"- {x}" for x in changed[:120]], *(["- ..."] if len(changed) > 120 else []), ""]
    ux = [x for x in ux_load(p)["items"] if x.get("task") == tid and x["status"] in UX_OPEN]
    if ux:
        parts += ["## UX problems this task is to solve (register: .satory/run/ux.md)", "",
                  *[f"- {ux_line(x)}" + (f": {x['detail'][:200]}" if x.get("detail") else "") for x in ux], ""]
    notes_dir = p.run / "notes"
    notes = sorted(notes_dir.glob(f"{tid}-*.md")) if notes_dir.is_dir() else []
    if notes:
        parts += ["## Notes from earlier rounds (each role reads only its own)", "",
                  *[f"- {p.rel(x)}" for x in notes], ""]
    freg = findings_load(p, tid)
    if freg["items"]:
        parts += ["## Findings of this task (full record: .satory/run/findings/" + tid + "/<id>.md)", "",
                  *[f"- {finding_line(f)}" for f in freg["items"]], ""]
    reviews = st.get("reviews") or {}
    if reviews:
        rounds = st.get("rounds", 0)
        parts += ["## Last results of the automatic checks", ""]
        for stage, r in reviews.items():
            stale = f"; not re-checked since round {r.get('round')}" if (r.get("round") or 0) < rounds else ""
            parts += [f"### {stage} (round {r.get('round')}, {r.get('verdict') or '-'}{stale})", r.get("note", "").strip(), ""]
    body = "\n".join(parts).rstrip() + "\n"
    out.write_text(body, encoding="utf-8")
    return {"path": p.rel(out), "chars": len(body), "requirements": ids, "missing": missing,
            "notes": [p.rel(x) for x in notes]}


def refresh_context(p: Project, tid: str) -> str | None:
    """write_context for the steps: an error is returned, never raised (the digest must not fail a step)."""
    try:
        write_context(p, tid)
        return None
    except Exception as e:  # noqa: BLE001 - any failure only costs the digest
        return f"context digest: {e}"


def save_review(p: Project, st: dict, stage: str, rnd: int, verdict: str, note: str) -> None:
    """The last result of an automatic check (build/lint, the tests after QA, the whole e2e suite), kept in
    the state: the digest shows it and a resumed task gets the failed ones as its feedback. Only the CLI's own
    lines (results, logs) are kept, so nothing important is cut; the agents' findings are in the register."""
    st.setdefault("reviews", {})[stage] = {"round": rnd, "verdict": verdict, "note": (note or "")[:4000]}


def cmd_spec(p: Project, a) -> None:
    """`spec check`: checks the format of docs/SPEC.md (see parse_spec), writes the requirements model to
    .satory/run/requirements.json and reports the requirements no task covers."""
    spec = p.root / "docs" / "SPEC.md"
    if not spec.exists():
        raise SatoryError("docs/SPEC.md does not exist")
    text = spec.read_text(encoding="utf-8")
    lines = text.splitlines()
    model = spec_model(p, lines)
    plan = p.plan()
    covered: set[str] = set()
    for t in plan["tasks"]:
        covered.update(task_req_ids(t, model))
    by_id: dict[str, dict] = {}
    for it in model["items"]:
        by_id.setdefault(it["id"], it)
    uncovered = [it["id"] for it in model["items"] if it["kind"] == "requirement" and it["id"] not in covered
                 and not any(c in covered for c in by_id if by_id[c].get("parent") == it["id"])]
    m = re.search(r"\*\*(?:Version|Версия):\*\*\s*(\d+)", text)
    out = {"spec_version": int(m.group(1)) if m else None,
           "sha": __import__("hashlib").sha256(text.encode("utf-8")).hexdigest()[:16],
           "items": [{k: (v + 1 if k == "start" else v) for k, v in it.items()} for it in model["items"]],
           "sections": [{"title": x["title"], "line": x["start"] + 1, "items": x["items"]} for x in model["sections"]],
           "errors": model["errors"], "warnings": model["warnings"], "not_in_any_task": uncovered}
    path = p.run / "requirements.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    write_json(path, out)
    kinds = {k: sum(1 for it in model["items"] if it["kind"] == k) for k in ("requirement", "criterion", "cross")}
    emit({"ok": not model["errors"], "path": p.rel(path), "counts": kinds, "errors": model["errors"],
          "warnings": model["warnings"], "not_in_any_task": uncovered})


# ----------------------------------------------------------------- findings ---
# The findings of the checks of one task (Reviewer, QA, UI reviewer, Security) in one register with stable
# ids and a status, in .satory/run/findings/<task>.json; findings/<task>.md is the short list (one line each)
# and findings/<task>/F-N.md the full record with its history. A check verifies its own open findings in the
# next round (fixed / open / worse / dismissed) instead of reporting them again; Dev may dispute one, and the
# check that raised it decides. The non-blocking ones still open when the task finishes go to the polish task.

FINDING_BLOCKING = {"security": ("critical", "high", "medium")}
FINDING_SEVERITIES = {"security": ("info", "low", "medium", "high", "critical")}
DEFAULT_SEVERITIES = ("nit", "minor", "major", "blocker")
FINDING_OPEN = ("open", "disputed")


def finding_blocks(f: dict) -> bool:
    return f["severity"] in FINDING_BLOCKING.get(f["stage"], ("blocker", "major"))


def findings_path(p: Project, tid: str) -> Path:
    return p.run / "findings" / f"{tid}.json"


def findings_load(p: Project, tid: str) -> dict:
    return load_json(findings_path(p, tid), {"next": 1, "items": []})


def finding_line(f: dict) -> str:
    return (f"{f['id']} [{f['severity']}] [{f['stage']} r{f['round']}] {f['title']}"
            + (f" ({f['where']})" if f.get("where") else "") + f" - {f['status']}")


def findings_save(p: Project, tid: str, reg: dict) -> None:
    path = findings_path(p, tid)
    path.parent.mkdir(parents=True, exist_ok=True)
    write_json(path, reg)
    lines = [f"# Findings of {tid}", "", "Full record and history of each: findings/" + tid + "/<id>.md", ""]
    lines += [f"- {finding_line(f)}" for f in reg["items"]]
    (path.parent / f"{tid}.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
    d = path.parent / tid
    d.mkdir(exist_ok=True)
    for f in reg["items"]:
        body = [f"# {f['id']} - {f['title']}", "",
                f"- Check: {f['stage']}, raised in round {f['round']}", f"- Severity: {f['severity']}",
                f"- Status: {f['status']}", *([f"- Where: {f['where']}"] if f.get("where") else []), "",
                "## Finding", "", f.get("detail") or f["title"], ""]
        if f.get("fix"):
            body += ["## Suggested fix", "", f["fix"], ""]
        body += ["## History", "", *[f"- r{h.get('round')} {h.get('by')}: {h.get('event')}" + (f" - {h['note']}" if h.get("note") else "")
                                     for h in f.get("history", [])]]
        (d / f"{f['id']}.md").write_text("\n".join(body) + "\n", encoding="utf-8")


def finding_title(text: str) -> str:
    text = " ".join(str(text or "").split())
    m = re.match(r"(.{20,140}?[.!?])(\s|$)", text)
    return (m.group(1) if m else text[:140]).strip()


def cmd_finding(p: Project, a) -> None:
    tid = a.task
    reg = findings_load(p, tid)
    by_id = {f["id"]: f for f in reg["items"]}
    rnd = a.round
    if a.action == "list":
        items = [f for f in reg["items"] if (not a.open or f["status"] in FINDING_OPEN) and (not a.stage or f["stage"] == a.stage)]
        return emit({"ok": True, "items": items, "count": len(items)})
    try:
        data = json.loads(read_note(a) or "{}")
    except json.JSONDecodeError as e:
        raise SatoryError(f"finding {a.action} expects JSON on stdin: {e}")
    if a.action == "record":
        stage = a.stage
        only = [x for x in (a.only or "").split(",") if x]  # a re-ask: only these ids were asked about
        before = [f["id"] for f in reg["items"] if f["stage"] == stage and f["status"] in FINDING_OPEN
                  and (not only or f["id"] in only)]
        touched, warnings = set(), []
        for v in data.get("verified") or []:
            f = by_id.get(str(v.get("id", "")).strip())
            if not f:
                warnings.append(f"unknown finding {v.get('id')}")
                continue
            if f["stage"] != stage:
                warnings.append(f"{f['id']} belongs to {f['stage']}, not {stage}")
                continue
            status, note = str(v.get("status", "")).strip(), str(v.get("note") or "").strip()
            if status == "worse":
                scale = FINDING_SEVERITIES.get(stage, DEFAULT_SEVERITIES)
                new_sev = str(v.get("severity") or "")
                if new_sev in scale and f["severity"] in scale and scale.index(new_sev) > scale.index(f["severity"]):
                    f["severity"] = new_sev
                elif new_sev:
                    warnings.append(f"{f['id']}: severity {new_sev!r} is not higher than {f['severity']!r} on the {stage} scale - kept")
            if status in ("fixed", "dismissed"):
                f["status"] = status
            elif status in ("open", "worse"):
                f["status"] = "open"
            else:
                warnings.append(f"{f['id']}: unknown status {status!r}")
                continue
            f.setdefault("history", []).append({"round": rnd, "by": stage, "event": status, "note": note})
            touched.add(f["id"])
        added = []
        for n in data.get("new") or []:
            detail = str(n.get("detail") or n.get("issue") or n.get("description") or "").strip()
            title = str(n.get("title") or "").strip() or finding_title(detail)
            where = str(n.get("where") or "").strip()
            if not title:
                continue
            dup = next((f for f in reg["items"] if f["stage"] == stage and f["status"] in FINDING_OPEN
                        and f["title"] == title and f.get("where", "") == where), None)
            if dup:
                dup.setdefault("history", []).append({"round": rnd, "by": stage, "event": "reported again"})
                touched.add(dup["id"])
                continue
            fid = f"F-{reg['next']}"
            reg["next"] += 1
            sev = str(n.get("severity") or "")
            if sev not in FINDING_SEVERITIES.get(stage, DEFAULT_SEVERITIES):
                warnings.append(f"new finding with severity {sev!r} - recorded as {FINDING_SEVERITIES.get(stage, DEFAULT_SEVERITIES)[-2]}")
                sev = FINDING_SEVERITIES.get(stage, DEFAULT_SEVERITIES)[-2]  # unknown: blocking, to be safe
            f = {"id": fid, "stage": stage, "round": rnd, "severity": sev, "title": title,
                 "where": where, "detail": detail, "fix": str(n.get("fix") or "").strip(), "status": "open",
                 "history": [{"round": rnd, "by": stage, "event": "raised"}]}
            reg["items"].append(f)
            by_id[fid] = f
            added.append(fid)
        unverified = [x for x in before if x not in touched and by_id[x]["status"] in FINDING_OPEN]
        for x in unverified:
            by_id[x].setdefault("history", []).append({"round": rnd, "by": stage, "event": "not verified (still open)"})
        findings_save(p, tid, reg)
        mine = [f for f in reg["items"] if f["stage"] == stage and f["status"] in FINDING_OPEN]
        return emit({"ok": True, "added": added, "unverified": unverified, "warnings": warnings,
                     "open": mine, "blocking": [f for f in mine if finding_blocks(f)]})
    if a.action == "dispute":
        done = []
        for d in data if isinstance(data, list) else data.get("disputes") or []:
            f = by_id.get(str(d.get("id", "")).strip())
            if f and f["status"] == "open":
                f["status"] = "disputed"
                f.setdefault("history", []).append({"round": rnd, "by": "dev", "event": "disputed", "note": str(d.get("reason") or "")})
                done.append(f["id"])
        findings_save(p, tid, reg)
        return emit({"ok": True, "disputed": done})
    if a.action == "polish":
        left = [f for f in reg["items"] if f["status"] in FINDING_OPEN and not finding_blocks(f)]
        path = p.run / "polish.json"
        pol = load_json(path, {"items": []})
        seen = {(x.get("task"), x.get("finding")) for x in pol["items"]}
        for f in left:
            if (tid, f["id"]) not in seen:
                pol["items"].append({"task": tid, "finding": f["id"], "source": f"{f['stage']}-{tid}-r{f['round']}",
                                     "severity": f["severity"], "where": f.get("where", ""),
                                     "issue": f["title"] + (f": {f['detail']}" if f.get("detail") and f["detail"] != f["title"] else ""),
                                     "fix": f.get("fix", ""), "planned": None})
            f["status"] = "polish"
            f.setdefault("history", []).append({"round": rnd, "by": "satory", "event": "moved to the polish task"})
        write_json(path, pol)
        findings_save(p, tid, reg)
        if left:
            progress(p, f"🧽 {len(left)} small improvement(s) from {tid} noted for the polish task")
        return emit({"ok": True, "polish": [f["id"] for f in left]})
    raise SatoryError(f"unknown action {a.action}")


# ----------------------------------------------------------------- coverage ---
# Which acceptance criterion is covered by which task and which test. A test covers a criterion when its
# name carries the id ("AC-003.4: ..." in an e2e title, AC003_4_... in a unit test method); a done task's
# "QA: coverage" section that names the id counts as a weaker, written claim. Built on demand from the
# requirements model, the plan, the task files and the latest test list (.satory/run/tests.json).

COV_ORDER = ("untested", "claimed", "tested", "planned", "not_planned")


def canon(rid: str) -> str:
    """One form of an id for comparing: AC-003.4, AC-3.4 and AC003_4 are the same criterion."""
    m = re.match(r"([A-Z]{1,5})-?0*(\d+)(?:[._]0*(\d+))?$", rid)
    return f"{m.group(1)}-{int(m.group(2))}" + (f".{int(m.group(3))}" if m.group(3) else "") if m else rid


def expand_ids(text: str, crit: tuple[str, ...] = ("AC",)) -> set[str]:
    """The ids in a text, in their canonical form: as written (AC-003.4), ranges (AC-003.3 - AC-003.6) expanded,
    and the method-name form (AC003_4_..., NFR012_...; a sub-number only for criterion prefixes)."""
    ids = {canon(x if x.split("-")[0] in crit else x.split(".")[0]) for x in REQ_ID.findall(text)}
    for m in REQ_RANGE.finditer(text):
        lo, hi = int(m.group(2)), int(m.group(3))
        if lo <= hi <= lo + 50:
            ids |= {canon(f"{m.group(1)}.{n}") for n in range(lo, hi + 1)}
    for m in re.finditer(r"(?<![A-Za-z])([A-Z]{1,5})(\d{1,3})(?:_(\d{1,3}))?(?=_|\b)", text):
        pre = m.group(1)
        if pre in NOT_REQ or (len(m.group(2)) < 3 and not m.group(3)):
            continue  # T052_ is a task; a short bare number (R6) is not an id
        sub = m.group(3) if pre in crit else None
        ids.add(canon(f"{pre}-{m.group(2)}" + (f".{sub}" if sub else "")))
    return ids


def test_ids(name: str, crit: tuple[str, ...] = ("AC",)) -> set[str]:
    return expand_ids(name, crit)


def qa_coverage_ids(text: str, crit: tuple[str, ...] = ("AC",)) -> set[str]:
    m = re.search(r"^## QA: coverage\s*$(.*?)(?=^## |\Z)", text, re.M | re.S)
    return expand_ids(m.group(1), crit) if m else set()


def compute_coverage(p: Project, model: dict, names: list[str] | None = None) -> dict:
    """The status of each criterion and NFR: tested (a test name carries the id), claimed (only a done task's
    "QA: coverage" names it), untested (a done task names it, or only its requirement while no task still to
    do covers it, and no test), planned (a task still to do covers it), not_planned."""
    plan = p.plan()
    status = {t["id"]: merged_status(p, t) for t in plan["tasks"]}
    crit = crit_prefixes(p)
    if names is None:
        names = load_json(p.run / "tests.json", {}).get("names") or []
    by_test: dict[str, list[str]] = {}
    for n in names:
        for i in test_ids(n, crit):
            by_test.setdefault(i, []).append(n)
    items = [it for it in model["items"] if it["kind"] in ("criterion", "cross")]
    explicit: dict[str, list[str]] = {}
    via_parent: dict[str, list[str]] = {}
    claims: dict[str, list[str]] = {}
    for t in plan["tasks"]:
        # "AC-003.*" means the criteria at planning time, so it counts at the requirement level, not as naming
        # each criterion (a later SPEC version may add criteria a done task never built)
        ids = {canon(x) for x in task_req_ids(t, model, wildcards=False)}
        f = p.root / "docs" / "tasks" / f"{t['id']}.md"
        claimed = qa_coverage_ids(f.read_text(encoding="utf-8"), crit) if f.exists() and status[t["id"]] == "done" else set()
        for it in items:
            key = canon(it["id"])
            if key in ids:
                explicit.setdefault(it["id"], []).append(t["id"])
            elif it.get("parent") and canon(it["parent"]) in ids:
                via_parent.setdefault(it["id"], []).append(t["id"])
            if key in claimed:
                claims.setdefault(it["id"], []).append(t["id"])
    any_done = any(v == "done" for v in status.values())
    out = []
    for it in items:
        exp, par = explicit.get(it["id"], []), via_parent.get(it["id"], [])
        tasks = exp + [x for x in par if x not in exp]
        done = [x for x in tasks if status.get(x) == "done"]
        pending = [x for x in tasks if status.get(x) != "done"]
        tests = by_test.get(canon(it["id"]), [])
        if tests:
            st = "tested"
        elif claims.get(it["id"]):
            st = "claimed"
        elif any(status.get(x) == "done" for x in exp):
            st = "untested"  # a done task names this very criterion and nothing tests it
        elif pending:
            st = "planned"
        elif done:
            st = "untested"
        elif it["kind"] == "cross" and any_done:
            st = "untested"  # an NFR applies to everything built so far
        else:
            st = "not_planned"
        out.append({"id": it["id"], "kind": it["kind"], "title": it["title"], "parent": it.get("parent"),
                    "status": st, "tasks": tasks, "done_tasks": done, "pending_tasks": pending, "claimed_in": claims.get(it["id"], []),
                    "tests": len(tests), "test_examples": tests[:3]})
    return {"items": out, "counts": coverage_counts(out), "tests_listed": len(names),
            "test_list": load_json(p.run / "tests.json", {}).get("listed")}


def coverage_counts(items: list[dict]) -> dict:
    return {k: sum(1 for x in items if x["status"] == k) for k in COV_ORDER}


def coverage_line(c: dict) -> str:
    ex = f" - e.g. {c['test_examples'][0][:110]}" if c["test_examples"] else ""
    return (f"{c['id']} [{c['status']}] {c['title'][:70]}" + (f" - tests: {c['tests']}" if c["tests"] else "")
            + (f" - claimed in {', '.join(c['claimed_in'])}" if c["status"] == "claimed" else "")
            + (f" - also in {', '.join(c.get('pending_tasks', [])[:3])} (still to do)" if c["status"] in ("untested", "claimed") and c.get("pending_tasks") else "")
            + ex)


def cmd_coverage(p: Project, a) -> None:
    spec = p.root / "docs" / "SPEC.md"
    if not spec.exists():
        raise SatoryError("docs/SPEC.md does not exist")
    model = spec_model(p, spec.read_text(encoding="utf-8").splitlines())
    names = None
    if a.refresh:
        if p.current_branch() != p.main:
            raise SatoryError(f"--refresh lists the tests of the checked-out branch; run it on {p.main}")
        listed, found = test_names(p, cache=True)
        if not listed:
            raise SatoryError("the test list could not be produced (commands.test_list)")
        names = sorted(found)
    cov = compute_coverage(p, model, names)
    if a.task:  # one task's criteria: printed only, the project-wide files stay as they are
        ids = set(task_req_ids(p.task(p.plan(), a.task), model))
        cov["items"] = [c for c in cov["items"] if c["id"] in ids or (c.get("parent") in ids)]
        cov["counts"] = coverage_counts(cov["items"])
        return emit({"ok": True, "task": a.task, "counts": cov["counts"], "items": cov["items"]})
    write_json(p.run / "coverage.json", cov)
    lines = [f"# Coverage of the acceptance criteria ({now()})", "",
             "Statuses: tested (a test name carries the id), claimed (only the task's 'QA: coverage' names it), "
             "untested (a done task covers it, no test), planned, not_planned.", "",
             f"Counts: {', '.join(f'{k} {v}' for k, v in cov['counts'].items() if v)}; tests listed: {cov['tests_listed']}"
             + (f" ({cov['test_list']})" if cov.get("test_list") else " - run `satory coverage --refresh` to list them"), ""]
    for k in COV_ORDER:
        group = [c for c in cov["items"] if c["status"] == k]
        if group:
            lines += [f"## {k} ({len(group)})", "", *[f"- {coverage_line(c)}" for c in group], ""]
    (p.run / "coverage.md").write_text("\n".join(lines), encoding="utf-8")
    emit({"ok": True, "path": p.rel(p.run / "coverage.md"), "counts": cov["counts"], "tests_listed": cov["tests_listed"],
          "untested": [c["id"] for c in cov["items"] if c["status"] == "untested"],
          "claimed": [c["id"] for c in cov["items"] if c["status"] == "claimed"],
          "not_planned": [c["id"] for c in cov["items"] if c["status"] == "not_planned"]})


# ----------------------------------------------------------------------- ux ---
# The register of the app's design and usability problems, for the whole project (.satory/run/ux.json): the
# problems of the design audit (docs/design/AUDIT.md) and of the UX reviews, each with its id, page, severity
# and status - open, planned (in a task), resolved (confirmed by the UI reviewer or a later UX review) or
# dismissed (by the user). A later UX review verifies the open ones and does not propose the others again.

UX_OPEN = ("open", "planned")
UX_LEVEL = {"критичен": "critical", "критична": "critical", "висок": "high", "висока": "high", "среден": "medium",
            "средна": "medium", "нисък": "low", "ниска": "low", "critical": "critical", "high": "high", "medium": "medium",
            "low": "low", "major": "high", "minor": "low", "blocker": "critical"}
AUDIT_ITEM = re.compile(r"^\s*\d+\.\s+\*\*([^\s\[\]*]{1,6}-\d{1,3})\s+\[([^\]]+)\]\s+(.+?)\*\*\s*(.*)$")
_CYR = dict(zip("АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЬЮЯ", ["A", "B", "V", "G", "D", "E", "ZH", "Z", "I", "Y", "K", "L", "M", "N",
               "O", "P", "R", "S", "T", "U", "F", "H", "TS", "CH", "SH", "SHT", "A", "Y", "YU", "YA"]))


def fold(text: str) -> str:
    """Cyrillic capitals in Latin letters, so an id written П-04 and P-04 is the same id when matching."""
    return "".join(_CYR.get(c, c) for c in text)


def ux_load(p: Project) -> dict:
    return load_json(p.run / "ux.json", {"next": 1, "audits": 0, "items": []})


def ux_line(x: dict, task_status: dict | None = None) -> str:
    done = task_status and x.get("task") and x["status"] == "planned" and task_status.get(x["task"]) == "done"
    return (f"{x['id']} [{x['severity']}] {x['title']}" + (f" ({x['page']})" if x.get("page") else "")
            + f" - {x['status']}" + (f" in {x['task']}" if x.get("task") else "") + (" (that task is done - check it)" if done else ""))


def ux_save(p: Project, reg: dict) -> None:
    write_json(p.run / "ux.json", reg)
    try:
        ts = {t["id"]: merged_status(p, t) for t in p.plan()["tasks"]}
    except Exception:  # noqa: BLE001 - the list is still written without the task statuses
        ts = {}
    lines = ["# UX register", "",
             "Statuses: open, planned (in a task), resolved, dismissed (by the user). A planned problem whose task is done "
             "still waits for a check (UI reviewer or UX review).", "", *[f"- {ux_line(x, ts)}" for x in reg["items"]]]
    (p.run / "ux.md").write_text("\n".join(lines) + "\n", encoding="utf-8")


def ux_add(reg: dict, items: list[dict], source: str, task: str | None = None, audit: int | None = None) -> list[str]:
    added = []
    for n in items:
        title = " ".join(str(n.get("title") or "").split())
        if not title:
            continue
        page = str(n.get("page") or "").strip()
        ref = str(n.get("ref") or "").strip()
        # the same problem again (also a dismissed one: the user's decision stays) is not added twice
        if any(x["title"] == title and x.get("page", "") == page for x in reg["items"]):
            continue
        used = {x["id"] for x in reg["items"]}
        if ref and ref not in used:
            xid = ref
        else:
            xid = f"UX-{reg['next']}"
            reg["next"] += 1
        sev = UX_LEVEL.get(str(n.get("severity") or "").strip().lower(), str(n.get("severity") or "medium").strip().lower())
        reg["items"].append({"id": xid, "ref": ref or xid, "audit": audit, "title": title, "page": page, "severity": sev,
                             "detail": str(n.get("detail") or ""), "source": source, "status": "planned" if task else "open",
                             "task": task, "history": [{"date": now(), "event": f"raised by {source}" + (f", planned in {task}" if task else "")}]})
        added.append(xid)
    return added


def task_text(t: dict) -> str:
    """The words of a task (title, description, criteria, subtasks), for finding the ids it names."""
    subs = t.get("subtasks") or []
    return "\n".join([t.get("title") or "", t.get("description") or "", *(t.get("acceptance") or []),
                      *[f"{x.get('title') or ''}\n{x.get('description') or ''}\n" + "\n".join(x.get("acceptance") or []) for x in subs]])


def ux_link_tasks(p: Project, tasks: list[dict]) -> list[str]:
    """Marks as planned the open problems a task names by id. An id names the problem of the latest audit with
    that reference (a new audit numbers its problems again); Cyrillic and Latin letters match (П-04 = P-04)."""
    reg = ux_load(p)
    keys: dict[str, dict] = {}
    for x in sorted(reg["items"], key=lambda x: x.get("audit") or 0):
        for k in {fold(x["id"]), fold(x.get("ref") or x["id"])}:
            keys[k] = x  # a later audit wins, whatever its status
    keys = {k: x for k, x in keys.items() if x["status"] == "open"}
    if not keys:
        return []
    linked = []
    for t in tasks:
        text = fold(task_text(t))
        for k, x in keys.items():
            if x["status"] == "open" and re.search(rf"(?<![\w-]){re.escape(k)}(?!\d)", text):
                x["status"], x["task"] = "planned", t["id"]
                x.setdefault("history", []).append({"date": now(), "event": f"planned in {t['id']}"})
                linked.append(x["id"])
    if linked:
        ux_save(p, reg)
    return linked


def cmd_ux(p: Project, a) -> None:
    reg = ux_load(p)
    if a.action == "list":
        if reg["items"]:
            ux_save(p, reg)  # ux.md shows the current task statuses ("that task is done - check it")
        items = [x for x in reg["items"] if (not a.open or x["status"] in UX_OPEN) and (not a.task or x.get("task") == a.task)]
        return emit({"ok": True, "items": items, "count": len(items),
                     "counts": {k: sum(1 for x in reg["items"] if x["status"] == k) for k in ("open", "planned", "resolved", "dismissed")}})
    if a.action == "import-audit":
        path = Path(a.target or "docs/design/AUDIT.md")
        path = path if path.is_absolute() else p.root / path
        if not path.exists():
            raise SatoryError(f"{path} does not exist")
        page, items = "", []
        for line in path.read_text(encoding="utf-8").splitlines():
            h = HEADING.match(line)
            if h and len(h.group(1)) == 2:
                page = re.sub(r"^\d+\.\s*", "", h.group(2)).strip()
            m = AUDIT_ITEM.match(line)
            if m:
                items.append({"ref": m.group(1), "severity": m.group(2), "title": m.group(3).strip().rstrip("."),
                              "page": page, "detail": m.group(4).strip()[:600]})
        reg["audits"] = reg.get("audits", 0) + 1
        added = ux_add(reg, items, f"design audit {reg['audits']}", audit=reg["audits"])
        ux_save(p, reg)
        return emit({"ok": True, "found": len(items), "added": added})
    if a.action == "link":  # the open problems that tasks still to do name by id become planned in them
        plan = p.plan()
        linked = ux_link_tasks(p, [t for t in plan["tasks"] if merged_status(p, t) != "done"])
        return emit({"ok": True, "linked": linked})
    if a.action == "dismiss":
        x = next((x for x in reg["items"] if x["id"] == a.target), None)
        if not x:
            raise SatoryError(f"unknown UX problem {a.target}")
        x["status"] = "dismissed"
        x.setdefault("history", []).append({"date": now(), "event": "dismissed by the user", "note": read_note(a).strip()})
        ux_save(p, reg)
        return emit({"ok": True})
    try:
        data = json.loads(read_note(a) or "[]")
    except json.JSONDecodeError as e:
        raise SatoryError(f"ux {a.action} expects JSON on stdin: {e}")
    if a.action == "add":
        added = ux_add(reg, data if isinstance(data, list) else [data], a.source or "review", a.task)
        ux_save(p, reg)
        return emit({"ok": True, "added": added})
    if a.action == "verify":  # [{id, status: resolved|open, note}] from the UI reviewer or a UX review
        done, warnings = [], []
        for v in data:
            x = next((x for x in reg["items"] if x["id"] == str(v.get("id", "")).strip()), None)
            if not x or x["status"] not in UX_OPEN:
                warnings.append(f"{v.get('id')}: not an open UX problem")
                continue
            if v.get("status") == "resolved":
                x["status"] = "resolved"
                x["task"] = a.task or x.get("task")
                done.append(x["id"])
            elif x["status"] == "planned" and x.get("task") and x["task"] != a.task \
                    and any(t["id"] == x["task"] and merged_status(p, t) == "done" for t in p.plan()["tasks"]):
                x["status"], x["task"] = "open", None  # its task is done and did not solve it: open again
            x.setdefault("history", []).append({"date": now(), "event": f"{v.get('status')} ({a.source or 'review'})",
                                                "note": str(v.get("note") or "")})
        ux_save(p, reg)
        return emit({"ok": True, "resolved": done, "warnings": warnings})
    raise SatoryError(f"unknown action {a.action}")


def cmd_task_context(p: Project, a) -> None:
    emit({"ok": True, **write_context(p, a.task)})


def guard(p: Project, ref: str, allowed) -> list[str]:
    violations = []
    for path, status in sorted(changed_files(p, ref).items()):
        reason = allowed(path, status)
        if reason:
            restore(p, ref, path, status)
            violations.append(f"{path}: {reason} - reverted")
    return violations


def cmd_step(p: Project, a) -> None:
    tid, rnd = a.task, a.round
    st = p.task_state(tid)
    ck, base = st["checkpoint"], st["base"]
    note = read_note(a)
    tests = p.test_globs

    if a.step == "after-dev":
        def allowed(path, status):
            if matches(path, PROTECTED):
                if a.owner == "devops" and path == ".satory/project.json":
                    return None
                return "protected file"
            if matches(path, tests):
                if a.owner == "devops" and not p.git_ok("cat-file", "-e", f"{base}:{path}"):
                    return None  # bootstrap may create test infrastructure, never change existing tests
                return "tests belong to QA"
            return None
        violations = guard(p, ck, allowed)
        gates = {g: gate(p, tid, rnd, g) for g in ("build", "lint")}
        ok = all(g["ok"] for g in gates.values())
        st["rounds"] = rnd
        st["checkpoint"] = checkpoint(p, tid, f"{a.owner} r{rnd}")
        extra = [f"- Violation: {v}" for v in violations]
        extra += [f"- Check {k}: {'✓' if g['ok'] else '✗'}{' (skipped)' if g.get('skipped') else ''}"
                  for k, g in gates.items()]
        journal_pending(p, tid, a.owner, rnd, "ok" if ok else "gate-fail", join_note(note, extra))
        if not ok:
            save_review(p, st, "build/lint", rnd, "gate-fail", "\n".join(extra + [f"- Log of {k}: {g.get('log')}" for k, g in gates.items() if not g["ok"]]))
        else:
            (st.get("reviews") or {}).pop("build/lint", None)
        p.save_state()
        emit({"ok": ok, "violations": violations, "gates": gates, "checkpoint": st["checkpoint"],
              "context_error": refresh_context(p, tid)})

    elif a.step == "pre-qa":
        res = deploy(p, "staging", label=f"{tid}-r{rnd}")
        emit(res)

    elif a.step == "after-qa":
        task_file = f"docs/tasks/{tid}.md"

        def allowed(path, status):
            if path == task_file or (matches(path, tests) and not matches(path, PROTECTED)):
                return None
            return "QA may change only tests and its own section of the task file"
        # soft: files QA must not touch at all - reverted, QA's tests are kept
        violations = guard(p, ck, allowed)
        # hard: append-only rule for tests - offending files go back to the pre-QA state and QA must redo.
        # Exception: a test file from an earlier task that QA lists, with a reason, in the
        # "QA: adapted tests" section of the task file (a change the task's requirements force).
        adapted = adapted_tests(p.root / task_file)
        adapted_used = []
        rules = []
        for path, status in sorted(changed_files(p, ck).items()):
            if not matches(path, tests) or not p.git_ok("cat-file", "-e", f"{ck}:{path}"):
                continue
            in_base = p.git_ok("cat-file", "-e", f"{base}:{path}")
            if status == "D":
                rules.append(f"{path}: deleted test file - restored")
            elif in_base:
                numstat = p.git("diff", "--numstat", base, "--", path).split()
                if not numstat or numstat[1] in ("0", "-"):
                    continue
                if path in adapted:
                    added = int(numstat[0]) if numstat[0].isdigit() else 0
                    if added >= int(numstat[1]):  # an adaptation replaces lines, it never removes tests
                        adapted_used.append(f"{path} - {adapted[path]}")
                        continue
                    rules.append(f"{path}: listed in \"QA: adapted tests\", but it lost lines ({numstat[1]} deleted, "
                                 f"{added} added) - an adaptation may only change expectations, never remove "
                                 "tests or assertions; the file was restored to its pre-QA state")
                    restore(p, ck, path, status)
                    continue
                rules.append(f"{path}: changed/deleted lines in a test file from an earlier task "
                             "(only additions are allowed, unless the file is listed with a reason in "
                             "\"QA: adapted tests\" of the task file) - the file was restored to its pre-QA state")
            else:
                continue  # QA's own test file from this task: corrections allowed, names are checked below
            restore(p, ck, path, status)
        listed, names = test_names(p, tid, rnd)
        known = set(st.get("known_tests", []))
        missing = sorted(known - names) if listed else []
        # a case of a parameterised test carries its data in its name: an adaptation listed in "QA: adapted
        # tests" that changes the data renames the case. It is allowed while the test method still has cases.
        methods = {x.split("(", 1)[0] for x in names}
        if adapted_used and missing:
            renamed = [x for x in missing if "(" in x and x.split("(", 1)[0] in methods]
            if renamed:
                adapted_used.append(f"{len(renamed)} case(s) of parameterised tests with changed data: "
                                    + "; ".join(renamed[:5]) + (" …" if len(renamed) > 5 else ""))
                missing = [x for x in missing if x not in renamed]
        if missing:
            rules.append(f"{len(missing)} existing tests are missing (deleted or renamed): "
                         f"{', '.join(missing[:20])}")
        if rules:
            journal_pending(p, tid, "qa", rnd, "fail",
                            join_note(note, [f"- Violation: {v}" for v in violations + rules]
                                      + ["- QA has to redo its work."]))
            emit({"ok": False, "qa_violation": True, "violations": violations + rules,
                  "tests": {"listed": listed, "count": len(names), "missing": missing[:50]}})
            return
        if listed:
            st["known_tests"] = sorted(known | names)
        gates = {"test": gate(p, tid, rnd, "test")}
        # only this task's e2e tests (+ smoke) here; the whole suite runs in step full-e2e after Security -
        # or here again when it failed in the previous round. Only for a workflow that runs that step
        # (--split-e2e): an older one would otherwise finish without the whole suite.
        first = p.e2e_task_commands(tid)
        if first and a.split_e2e and not st.get("full_e2e_failed"):
            gates["e2e"] = {**e2e_run(p, tid, rnd, first, "e2e-task"), "scope": "task"}
        else:
            gates["e2e"] = e2e_run(p, tid, rnd, p.commands("e2e"), "e2e")
            st["full_e2e_failed"] = not gates["e2e"]["ok"]
        gates_ok = all(g["ok"] for g in gates.values())
        st["checkpoint"] = checkpoint(p, tid, f"qa r{rnd}")
        extra = [f"- Violation: {v}" for v in violations]
        extra += [f"- Adapted test file from an earlier task: {x}" for x in adapted_used]
        extra += [f"- Tests: {len(names) if listed else '?'} (list {'available' if listed else 'could not be produced'})"]
        extra += [f"- Check {k}: {'✓' if g['ok'] else '✗'}{' (skipped)' if g.get('skipped') else ''}"
                  f"{' (only this task and smoke tests; the whole suite runs after Security)' if g.get('scope') == 'task' else ''}"
                  for k, g in gates.items()]
        extra += [f"- Flaky (passed on the retry): {t}" for g in gates.values() for t in g.get("flaky", [])]
        verdict = "fail" if (not gates_ok or a.verdict == "fail") else "pass"
        journal_pending(p, tid, "qa", rnd, verdict, join_note(note, extra))
        head = (note or "").split("\n\n")[0].strip()[:800]
        save_review(p, st, "qa checks", rnd, verdict,
                    "\n".join([f"- QA verdict: {a.verdict or '-'}" + (f"; summary: {head}" if head else ""), *extra,
                               *[f"- Log of {k}: {g.get('log')}" for k, g in gates.items() if not g["ok"]]]))
        if gates["e2e"].get("scope") != "task":  # the whole suite ran here: its result is in the qa entry
            (st.get("reviews") or {}).pop("full e2e", None)
        p.save_state()
        emit({"ok": gates_ok, "qa_violation": False, "violations": violations, "adapted": adapted_used,
              "tests": {"listed": listed, "count": len(names), "missing": []},
              "gates": gates, "checkpoint": st["checkpoint"], "context_error": refresh_context(p, tid)})

    elif a.step == "security-scan":
        scans = []
        for i, cmd in enumerate(p.commands("security")):
            log = p.logs / f"{tid}-r{rnd}-security-{i + 1}.log"
            res = run_cmds(p, [cmd], log, p.env(tid, rnd))
            res["cmd"] = cmd
            if res.get("exit") == 127:
                res["missing_tool"] = True
            scans.append(res)
        # scanners must not leave changes behind
        guard(p, ck, lambda path, status: "scanner artifact")
        emit({"ok": all(s["ok"] or s.get("missing_tool") for s in scans), "scans": scans})

    elif a.step == "full-e2e":
        # the whole e2e suite, once Review, QA, UI and Security have passed
        g = e2e_run(p, tid, rnd, p.commands("e2e"), "e2e")
        st["full_e2e_failed"] = not g["ok"]
        guard(p, ck, lambda path, status: "test run artifact")
        extra = [f"- Whole e2e suite: {'✓' if g['ok'] else '✗ - back to Dev; the next round runs it again in QA'}"]
        extra += [f"- Flaky (passed on the retry): {t}" for t in g.get("flaky", [])]
        journal_pending(p, tid, "e2e", rnd, "pass" if g["ok"] else "fail", join_note(note, extra))
        save_review(p, st, "full e2e", rnd, "pass" if g["ok"] else "fail", "\n".join(extra + [f"- Log: {g.get('log')}"]))
        p.save_state()
        emit({"ok": g["ok"], "gates": {"e2e": g}, "context_error": refresh_context(p, tid)})

    elif a.step == "docs-check":
        changed = changed_files(p, ck)
        changelog = p.root / "CHANGELOG.md"
        has_entry = ("CHANGELOG.md" in changed and changelog.exists()
                     and tid in changelog.read_text(encoding="utf-8"))
        emit({"ok": has_entry, "changelog": has_entry, "changed": sorted(changed)})

    elif a.step == "readonly":
        changed = changed_files(p, ck)
        if changed:
            p.git("reset", "-q", "--hard", ck)
            p.git("clean", "-fdq")
        extra = [f"- Violation: {a.stage} changed {path} - reverted" for path in sorted(changed)]
        journal_pending(p, tid, a.stage, rnd, a.verdict or "ok", join_note(note, extra))
        emit({"ok": True, "reverted": sorted(changed), "context_error": refresh_context(p, tid)})

    else:
        raise SatoryError(f"unknown step {a.step}")


def main_unchanged(p: Project, st: dict, tid: str) -> None:
    """main changes only between tasks; everything else waits in the queue (satory queue)."""
    head = p.git("rev-parse", p.main)
    if head != st["base"]:
        raise SatoryError(f"{p.main} changed while {tid} ran ({st['base'][:12]} -> {head[:12]}); changes to "
                          f"{p.main} go through `satory queue` and are applied between tasks. Run the build again: "
                          f"the task is rebased onto {p.main} and goes on.")


def cmd_task_finish(p: Project, a) -> None:
    tid = a.task
    st = p.task_state(tid)
    main_unchanged(p, st, tid)
    plan = p.plan()
    t = p.task(plan, tid)
    note = read_note(a)
    violations = guard(p, st["checkpoint"], lambda path, status: None
                       if matches(path, DOCS_ALLOWED) and not matches(path, PROTECTED)
                       else "the technical writer may change only documentation")
    checkpoint(p, tid, "docs")
    branch = st["branch"]
    p.git("checkout", "-q", p.main)
    r = p.git("merge", "--squash", branch, check=False)
    if r.returncode != 0:
        p.git("reset", "-q", "--hard", "HEAD")
        p.git("checkout", "-q", branch)
        raise SatoryError(f"squash merge of {branch} failed: {(r.stderr or r.stdout).strip()}")
    t["status"], t["rounds"], t["finished"] = "done", st["rounds"], now()
    t.pop("blocked_reason", None)
    p.save_plan(plan)
    extra = [f"- Violation: {v}" for v in violations]
    journal_pending(p, tid, "docs", st["rounds"], "done",
                    join_note(note, extra + [f"- Task finished after {st['rounds']} round(s)."]))
    journal_flush(p)
    del p.state["tasks"][tid]
    render_plan(p, plan)
    p.git("add", "-A")
    kind = "build" if t["owner"] == "devops" else "feat"
    p.git("commit", "-q", "-m",
          f"{kind}({tid}): {t['title']}\n\nRounds: {st['rounds']} · details: docs/tasks/{tid}.md\n\n{TRAILER}")
    commit = p.git("rev-parse", "HEAD")
    p.git("branch", "-D", branch)
    p.save_state()
    pushed, push_error = False, None
    if p.git_ok("remote", "get-url", "origin"):
        push_error = push_quiet(p, "origin", p.main)
        pushed = push_error is None
        if pushed and p.git_ok("ls-remote", "--exit-code", "--heads", "origin", branch):
            push_quiet(p, "origin", "--delete", branch)  # the copy of the work in progress is merged
    staging = deploy(p, "staging", label=f"main-{commit[:12]}")
    if not staging.get("skipped"):
        p.state.setdefault("deploy", {})["main_image"] = staging.get("image")
        p.state["deploy"]["main_sha"] = commit
        p.save_state()
    progress(p, f"✓ {tid} done in {st['rounds']} round(s) ({commit[:7]}){', pushed' if pushed else ''}"
                f"{', staging updated' if staging.get('ok') and not staging.get('skipped') else ''}"
                f" - {done_count(p, plan)}")
    emit({"ok": True, "commit": commit, "violations": violations, "pushed": pushed,
          "push_error": push_error, "staging": staging})


def cmd_task_block(p: Project, a) -> None:
    tid = a.task
    st = p.task_state(tid)
    reason = read_note(a).strip() or "no reason given"
    main_unchanged(p, st, tid)
    plan = p.plan()
    t = p.task(plan, tid)
    if p.current_branch() == st["branch"]:
        st["checkpoint"] = checkpoint(p, tid, "blocked")
        p.git("checkout", "-q", p.main)
    t["status"], t["blocked_reason"], t["rounds"] = "blocked", reason, st["rounds"]
    p.save_plan(plan)
    journal_pending(p, tid, "orchestrator", st["rounds"], "blocked", reason)
    journal_flush(p)
    render_plan(p, plan)
    p.git("add", "-A")
    p.git("commit", "-q", "-m", f"chore(plan): {tid} is blocked\n\n{TRAILER}")
    p.save_state()
    emit({"ok": True, "task": tid, "branch_kept": st["branch"]})


def cmd_task_unblock(p: Project, a) -> None:
    tid = a.task
    answer = read_note(a).strip()
    if p.current_branch() != p.main or p.dirty():
        raise SatoryError(f"run unblock on a clean {p.main}")
    plan = p.plan()
    t = p.task(plan, tid)
    if answer:
        t.setdefault("clarifications", []).append({"date": now("%Y-%m-%d"), "text": answer})
    t["status"] = "todo"
    t.pop("blocked_reason", None)
    p.save_plan(plan)
    if tid in p.state["tasks"]:
        p.state["tasks"][tid]["rounds"] = 0
        p.state["tasks"][tid].pop("reviews", None)  # the round numbers start again; old check results would read as current
        reg = findings_load(p, tid)  # the findings stay (Dev needs them with the guidance), marked
        for f in reg["items"]:
            if f["status"] in FINDING_OPEN:
                f.setdefault("history", []).append({"round": 0, "by": "user", "event": "task unblocked; still open"})
        if reg["items"]:
            findings_save(p, tid, reg)
        p.save_state()
    journal_pending(p, tid, "user", None, "unblocked", answer or "Unblocked without a clarification.")
    journal_flush(p)
    render_plan(p, plan)
    p.git("add", "-A")
    p.git("commit", "-q", "-m", f"chore(plan): {tid} is unblocked\n\n{TRAILER}")
    emit({"ok": True, "task": tid})


def cmd_deploy(p: Project, a) -> None:
    image = a.image
    if a.env == "prod" and not image:
        image = p.state.get("deploy", {}).get("main_image")
    emit(deploy(p, a.env, image=image, label="manual"))


def cmd_release(p: Project, a) -> None:
    version = a.version.lstrip("v")
    if p.current_branch() != p.main or p.dirty():
        raise SatoryError(f"release needs a clean {p.main}")
    if p.state["tasks"]:
        raise SatoryError(f"tasks in progress: {', '.join(p.state['tasks'])}")
    dep = p.state.get("deploy", {})
    image, built_sha = dep.get("main_image"), dep.get("main_sha")
    code_changed = True
    if image and built_sha and p.git_ok("cat-file", "-e", built_sha):
        changed = p.git("diff", "--name-only", built_sha, "HEAD").splitlines()
        code_changed = any(not matches(f, DOCS_ALLOWED + [".satory/**"]) for f in changed)
    changelog = p.root / "CHANGELOG.md"
    if changelog.exists():
        text = changelog.read_text(encoding="utf-8")
        marker = "## [Unreleased]"
        if marker in text:
            text = text.replace(marker, f"{marker}\n\n## [{version}] - {now('%Y-%m-%d')}", 1)
            changelog.write_text(text, encoding="utf-8")
    journal_pending(p, f"v{version}", "release", None, "release",
                    f"Released to production: v{version}" + (f" (image {image})" if image and not code_changed else ""))
    journal_flush(p)
    p.git("add", "-A")
    p.git("commit", "-q", "-m", f"chore(release): v{version}\n\n{TRAILER}")
    p.git("tag", "-a", f"v{version}", "-m", f"v{version}")
    if code_changed:
        staging = deploy(p, "staging", label=f"release-{version}")
        if not staging.get("ok") and not staging.get("skipped"):
            emit({"ok": False, "stage": "staging", "staging": staging})
            return
        image = staging.get("image")
    prod = deploy(p, "prod", image=image, label=f"v{version}")
    pushed = None
    if p.git_ok("remote", "get-url", "origin"):
        pushed = p.git("push", "-q", "--follow-tags", "origin", p.main, check=False).returncode == 0
    emit({"ok": prod.get("ok", False) or prod.get("skipped", False), "version": version, "prod": prod,
          "pushed": pushed})


def cmd_status(p: Project, a) -> None:
    plan = p.plan()
    counts = {s: 0 for s in STATUSES}
    for t in plan["tasks"]:
        counts[merged_status(p, t)] += 1
    emit({"ok": True, "name": p.config.get("name"), "branch": p.current_branch(), "counts": counts,
          "blocked": [{"id": t["id"], "title": t["title"], "reason": t.get("blocked_reason")}
                      for t in plan["tasks"] if t.get("status") == "blocked"],
          "in_progress": list(p.state["tasks"]), "deploy": p.state.get("deploy", {}),
          "questions": {"open": sum(q["status"] == "open" for q in questions_load(p)["items"]),
                        "critical_open": sum(q["status"] == "open" and q["severity"] == "critical"
                                             for q in questions_load(p)["items"]),
                        "deferred": sum(q["status"] == "deferred" for q in questions_load(p)["items"])},
          "remote": p.git("remote", "get-url", "origin") if p.git_ok("remote", "get-url", "origin") else None})


def cmd_statusline(a) -> None:
    """One plain line for the Claude Code status line. Claude Code passes the session as JSON on stdin;
    outside a satory project, or on any error, it prints nothing (the status line must never break)."""
    try:
        data = {}
        import select  # only for this command: wait briefly for the session JSON, never hang without it
        if not sys.stdin.isatty() and select.select([sys.stdin], [], [], 0.5)[0]:
            raw = sys.stdin.read()
            data = json.loads(raw) if raw.strip() else {}
        start = a.project or (data.get("workspace") or {}).get("current_dir") or data.get("cwd")
        p = Project.find(start)
        plan = p.plan()
        tasks = plan["tasks"]
        parts = [f"satory {sum(t.get('status') == 'done' for t in tasks)}/{len(tasks)}"]
        running = list(p.state.get("tasks", {}))
        for tid in running:
            parts.append(f"▶ {tid} r{p.state['tasks'][tid].get('rounds', 0)}")
        blocked = sum(t.get("status") == "blocked" for t in tasks)
        if blocked:
            parts.append(f"⛔{blocked}")
        if not running:
            nxt = next((t["id"] for t in tasks if t.get("status", "todo") == "todo"), None)
            if nxt:
                parts.append(f"next {nxt}")
        if p.progress_path.exists():
            with open(p.progress_path, "rb") as f:
                f.seek(max(0, f.seek(0, 2) - 4096))
                tail = f.read().decode("utf-8", "replace").splitlines()
            if tail:
                parts.append(first_line(tail[-1], 70))
        items = questions_load(p)["items"]
        open_q = sum(q["status"] == "open" for q in items)
        critical = sum(q["status"] == "open" and q["severity"] == "critical" for q in items)
        if open_q:
            parts.append(f"❓{open_q}{f' ({critical} critical)' if critical else ''}")
        queued = len(list((p.run / "queue").glob("*.json"))) if (p.run / "queue").is_dir() else 0
        if queued:
            parts.append(f"🗂{queued}")
        # an explicit colour, so the line stays readable whatever the terminal theme dims it to;
        # SATORY_STATUSLINE_COLOR is an SGR code (default 96, bright cyan; "" for none)
        color = os.environ.get("SATORY_STATUSLINE_COLOR", "96")
        line = " · ".join(parts)
        print(f"\033[{color}m{line}\033[0m" if color else line)
    except Exception:  # noqa: BLE001 - a status line prints nothing rather than an error
        pass


def cmd_doctor(a) -> None:
    def run(cmd: list[str]) -> subprocess.CompletedProcess | None:
        if not shutil.which(cmd[0]):
            return None
        return subprocess.run(cmd, capture_output=True, text=True, cwd=a.project or os.getcwd())

    def version(cmd: list[str]) -> str | None:
        r = run(cmd)
        return (r.stdout or r.stderr).strip().splitlines()[0] if r and r.returncode == 0 else None

    tools = {"git": ["git", "--version"], "python3": ["python3", "--version"], "docker": ["docker", "--version"],
             "docker compose": ["docker", "compose", "version"], "node": ["node", "--version"],
             "npx": ["npx", "--version"], "gh": ["gh", "--version"], "dotnet": ["dotnet", "--version"],
             "semgrep": ["semgrep", "--version"], "gitleaks": ["gitleaks", "version"]}
    found = {name: version(cmd) for name, cmd in tools.items()}
    setup = "run /satory-devteam:setup"
    problems, notes = [], []

    def problem(what: str, fix: str) -> None:
        problems.append({"what": what, "fix": fix})

    for name in ("git", "docker", "docker compose", "node", "npx", "gh"):
        if not found[name]:
            problem(f"{name} is missing", setup)
    if sys.version_info < MIN_PYTHON:
        problem(f"python3 is {sys.version.split()[0]}, the satory CLI needs {'.'.join(map(str, MIN_PYTHON))} or newer",
                "install a newer python3 (Ubuntu 22.04+ and Debian 12+ already have one)")
    for name in ("semgrep", "gitleaks"):
        if not found[name]:
            notes.append(f"scanner {name} is missing - the security checks will skip it ({setup})")
    if not found["dotnet"]:
        notes.append(".NET SDK is missing - needed only for .NET projects")

    ident = {k: (run(["git", "config", f"user.{k}"]) or subprocess.CompletedProcess([], 1, "", "")).stdout.strip()
             for k in ("name", "email")}
    if not (ident["name"] and ident["email"]):
        problem("no git identity (user.name / user.email)",
                'git config --global user.name "Name" && git config --global user.email "email"')

    docker_ok = None
    if found["docker"]:
        r = run(["docker", "info", "--format", "{{.ServerVersion}}"])
        docker_ok = bool(r and r.returncode == 0)
        if not docker_ok:
            problem("Docker is installed, but the daemon does not respond",
                    "sudo systemctl enable --now docker (on WSL: systemd=true in /etc/wsl.conf)")

    browsers = sorted(str(p.name) for p in (Path.home() / ".cache" / "ms-playwright").glob("chromium*"))
    if not browsers:
        problem("Playwright Chromium is not installed", "npx -y playwright install --with-deps chromium")

    github = {"logged_in": False, "account": None, "scopes": [], "git_credentials": False}
    if found["gh"]:
        r = run(["gh", "auth", "status", "-h", "github.com"])
        out = (r.stdout + r.stderr) if r else ""
        github["logged_in"] = bool(r and r.returncode == 0)
        for line in out.splitlines():
            if "account" in line and "Logged in" in line:
                github["account"] = line.split("account", 1)[1].split()[0]
            if "Token scopes:" in line:
                github["scopes"] = [x.strip(" '") for x in line.split(":", 1)[1].split(",") if x.strip(" '")]
        helper = run(["git", "config", "--global", "--get-all", "credential.https://github.com.helper"])
        github["git_credentials"] = bool(helper and "gh" in helper.stdout)
        if not github["logged_in"]:
            problem("not logged in to GitHub", "! gh auth login -h github.com -p https -w -s workflow   (then: gh auth setup-git)")
        else:
            missing = [s for s in ("repo", "workflow") if s not in github["scopes"]]
            if missing:
                problem(f"the GitHub token lacks the {', '.join(missing)} scope (needed to push CI files)",
                        f"! gh auth refresh -h github.com -s {','.join(missing)}")
            if not github["git_credentials"]:
                problem("git does not use the gh credentials", "gh auth setup-git")

    emit({"ok": not problems, "problems": problems, "notes": notes, "tools": found,
          "git_identity": ident if ident["email"] else None, "docker_running": docker_ok,
          "playwright_browsers": browsers, "github": github, "python": sys.version.split()[0]})


# ------------------------------------------------------------------- main ---

def main() -> None:
    if sys.version_info < MIN_PYTHON:
        emit({"ok": False, "error": f"python3 {'.'.join(map(str, MIN_PYTHON))} or newer is required "
                                    f"(this is {sys.version.split()[0]}); run /satory-devteam:setup"})
        sys.exit(1)
    ap = argparse.ArgumentParser(prog="satory")
    ap.add_argument("--project", help="project root (default: search upward from cwd)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("init")
    s.add_argument("--dir", required=True)
    s.add_argument("--name", required=True)
    s.add_argument("--git-name")
    s.add_argument("--git-email")
    sub.add_parser("doctor")
    sub.add_parser("where")
    sub.add_parser("workflow")
    sub.add_parser("status")
    sub.add_parser("statusline", help="one plain line for the Claude Code status line (session JSON on stdin)")
    s = sub.add_parser("plan")
    s.add_argument("action", choices=["json", "validate", "render", "add"])
    s.add_argument("--note-stdin", action="store_true")
    s.add_argument("--source", help="add: who changes the plan (journal)")

    s = sub.add_parser("task")
    s.add_argument("action", choices=["start", "finish", "block", "unblock", "context"])
    s.add_argument("task")
    s.add_argument("--note-stdin", action="store_true")

    s = sub.add_parser("step")
    s.add_argument("step", choices=["after-dev", "pre-qa", "after-qa", "security-scan", "full-e2e", "docs-check", "readonly"])
    s.add_argument("task")
    s.add_argument("--round", type=int, required=True)
    s.add_argument("--owner", choices=OWNERS, default="dev")
    s.add_argument("--stage", default="reviewer")
    s.add_argument("--verdict")
    s.add_argument("--note-stdin", action="store_true")
    s.add_argument("--split-e2e", action="store_true", help="the workflow runs step full-e2e (the whole e2e suite after Security)")

    s = sub.add_parser("question")
    s.add_argument("action", choices=["add", "list", "answer", "plan", "reviewed", "ux-reviewed", "register", "flush"])
    s.add_argument("target", nargs="?", help="question id (answer, plan) or milestone (reviewed)")
    s.add_argument("--source")
    s.add_argument("--task")
    s.add_argument("--milestone")
    s.add_argument("--open", action="store_true")
    s.add_argument("--status", help="answer: the new status; list: only these (comma-separated)")
    s.add_argument("--brief", action="store_true", help="list: only id, kind, severity, status, title, task")
    s.add_argument("--full", action="store_true", help="list: every field of every item")
    s.add_argument("--note-stdin", action="store_true")

    s = sub.add_parser("spec")
    s.add_argument("action", choices=["check"])

    s = sub.add_parser("ux")
    s.add_argument("action", choices=["add", "list", "verify", "dismiss", "import-audit", "link"])
    s.add_argument("target", nargs="?", help="dismiss: the id; import-audit: the audit file (default docs/design/AUDIT.md)")
    s.add_argument("--task", help="add: the task that will solve them (planned); verify: the task that solved them; list: only its")
    s.add_argument("--source", help="add/verify: who (e.g. 'ux review M2', 'ui T-062 r2')")
    s.add_argument("--open", action="store_true", help="list: only open and planned")
    s.add_argument("--note-stdin", action="store_true")

    s = sub.add_parser("coverage")
    s.add_argument("--task", help="only the criteria of this task")
    s.add_argument("--refresh", action="store_true", help="list the tests first (commands.test_list; can take minutes)")

    s = sub.add_parser("finding")
    s.add_argument("action", choices=["record", "dispute", "list", "polish"])
    s.add_argument("task")
    s.add_argument("--stage", help="record: the check (reviewer, qa, ui, security); list: only its findings")
    s.add_argument("--round", type=int, default=0)
    s.add_argument("--open", action="store_true", help="list: only open and disputed")
    s.add_argument("--only", help="record: a re-ask - only these ids (comma-separated) were asked about")
    s.add_argument("--note-stdin", action="store_true")

    s = sub.add_parser("design")
    s.add_argument("action", choices=["request", "status", "done", "log"])
    s.add_argument("--choice", help="request: the direction to use (its folder name under docs/design/directions)")
    s.add_argument("--note-stdin", action="store_true")

    s = sub.add_parser("polish")
    s.add_argument("action", choices=["add", "list", "planned"])
    s.add_argument("--task", help="add: the task the findings come from; planned: the polish task")
    s.add_argument("--source", help="add: who found them, e.g. 'reviewer T-012 r3'")
    s.add_argument("--note-stdin", action="store_true")

    s = sub.add_parser("queue")
    s.add_argument("action", choices=["begin", "add", "list", "apply"])
    s.add_argument("--branch", help="add: the branch with the documents of the change")
    s.add_argument("--dir", help="add: its worktree from `queue begin`; committed and removed")
    s.add_argument("--message", help="add: the commit message of the documents")
    s.add_argument("--source", help="add: who asks for it (journal)")
    s.add_argument("--note-stdin", action="store_true")

    s = sub.add_parser("wait")
    s.add_argument("id")
    s.add_argument("--timeout", type=int, default=540)

    s = sub.add_parser("deploy")
    s.add_argument("env", choices=["staging", "prod"])
    s.add_argument("--image")
    s = sub.add_parser("release")
    s.add_argument("--version", required=True)

    a = ap.parse_args()
    try:
        if a.cmd == "init":
            return cmd_init(a)
        if a.cmd == "doctor":
            return cmd_doctor(a)
        if a.cmd == "statusline":
            return cmd_statusline(a)
        p = Project.find(a.project)
        handlers = {"where": cmd_where, "workflow": cmd_workflow, "status": cmd_status, "plan": cmd_plan, "step": cmd_step,
                    "deploy": cmd_deploy, "release": cmd_release, "wait": cmd_wait, "question": cmd_question,
                    "queue": cmd_queue, "polish": cmd_polish, "design": cmd_design, "spec": cmd_spec,
                    "finding": cmd_finding, "coverage": cmd_coverage, "ux": cmd_ux}
        if a.cmd == "task":
            return {"start": cmd_task_start, "finish": cmd_task_finish, "block": cmd_task_block,
                    "unblock": cmd_task_unblock, "context": cmd_task_context}[a.action](p, a)
        return handlers[a.cmd](p, a)
    except SatoryError as e:
        emit({"ok": False, "error": str(e)})
        sys.exit(1)


if __name__ == "__main__":
    main()
